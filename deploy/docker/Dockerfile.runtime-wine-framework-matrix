# syntax=docker/dockerfile:1.7@sha256:a57df69d0ea827fb7266491f2813635de6f17269be881f696fbfdf2d83dda33e

# Candidate-only .NET Framework under Wine image.  The operator-supplied Wine
# image contains initialized x64 CLR 2 and CLR 4 layout paths. Each build still
# represents exactly one Framework row: the registry preflight below must match
# NETFX_RUNTIME_VERSION, so a 4.8 prefix cannot stand in for a 4.0-4.7.2 runtime.
# The control bridge never runs the user PE.

ARG SDK_IMAGE
ARG CONTROL_IMAGE
ARG WINE_IMAGE
ARG CONTROL_TFM

FROM ${SDK_IMAGE} AS publish
ARG SDK_IMAGE
ARG CONTROL_IMAGE
ARG WINE_IMAGE
ARG SOURCE_REVISION
ARG CONTROL_TFM
WORKDIR /source
COPY deploy/docker/validate-digest-pinned-image.sh /usr/local/bin/sharplabnext-validate-image
RUN chmod 0555 /usr/local/bin/sharplabnext-validate-image \
    && /usr/local/bin/sharplabnext-validate-image \
         SDK_IMAGE "${SDK_IMAGE}" \
         CONTROL_IMAGE "${CONTROL_IMAGE}" \
         WINE_IMAGE "${WINE_IMAGE}"
COPY global.json Directory.Build.props Directory.Build.targets Directory.Packages.props NuGet.config SharpLabNext.slnx ./
COPY profiles/versions.props ./profiles/versions.props
COPY src/ ./src/
RUN --mount=type=cache,id=sharplabnext-dotnet-nuget,target=/root/.nuget/packages,sharing=locked \
    dotnet restore \
      src/RuntimeJobs/SharpLabNext.TargetRuntimeRunner/SharpLabNext.TargetRuntimeRunner.csproj \
      --locked-mode \
    && dotnet restore \
      src/RuntimeJobs/SharpLabNext.DesktopClrJitInspector/SharpLabNext.DesktopClrJitInspector.csproj \
      --locked-mode \
    && dotnet restore \
      src/RuntimeJobs/SharpLabNext.WineRunner/SharpLabNext.WineRunner.csproj \
      --locked-mode \
    && dotnet publish \
      src/RuntimeJobs/SharpLabNext.TargetRuntimeRunner/SharpLabNext.TargetRuntimeRunner.csproj \
      --configuration Release \
      --framework net20 \
      --no-restore \
      --output /target-runtime-runner \
      /p:UseAppHost=false \
      /p:ContinuousIntegrationBuild=true \
      /p:SourceRevisionId=${SOURCE_REVISION} \
    && dotnet publish \
      src/RuntimeJobs/SharpLabNext.DesktopClrJitInspector/SharpLabNext.DesktopClrJitInspector.csproj \
      --configuration Release \
      --framework net20 \
      --no-restore \
      --output /desktop-clr-jit-inspector \
      /p:UseAppHost=false \
      /p:ContinuousIntegrationBuild=true \
      /p:SourceRevisionId=${SOURCE_REVISION} \
    && dotnet publish \
      src/RuntimeJobs/SharpLabNext.WineRunner/SharpLabNext.WineRunner.csproj \
      --configuration Release \
      --framework ${CONTROL_TFM} \
      --no-restore \
      --output /wine-runner \
      /p:UseAppHost=false \
      /p:ContinuousIntegrationBuild=true \
      /p:SourceRevisionId=${SOURCE_REVISION}

FROM ${WINE_IMAGE} AS wine-source
ARG NETFX_RUNTIME_VERSION
COPY deploy/docker/wine-netfx-framework-preflight.sh /usr/local/bin/sharplabnext-wine-netfx-preflight
COPY deploy/docker/dedupe-wine-prefixes.py /usr/local/bin/sharplabnext-dedupe-wine-prefixes
RUN set -eux; \
    chmod 0555 /usr/local/bin/sharplabnext-wine-netfx-preflight; \
    chmod 0555 /usr/local/bin/sharplabnext-dedupe-wine-prefixes; \
    test -x /usr/bin/wine-stable; \
    test -x /usr/lib/wine/wine64; \
    test -x /usr/lib/wine/wineserver64; \
    test -d /opt/wine-netfx-clr2/drive_c/windows/system32; \
    test -d /opt/wine-netfx-clr4/drive_c/windows/system32; \
    test -d /opt/wine-netfx-clr2/drive_c/windows/Microsoft.NET/Framework64/v2.0.50727; \
    test -f /opt/wine-netfx-clr2/drive_c/windows/Microsoft.NET/Framework64/v2.0.50727/mscorlib.dll; \
    test -d /opt/wine-netfx-clr4/drive_c/windows/Microsoft.NET/Framework64/v4.0.30319; \
    test -f /opt/wine-netfx-clr4/drive_c/windows/Microsoft.NET/Framework64/v4.0.30319/mscorlib.dll; \
    test -x /usr/local/bin/sharplabnext-dedupe-wine-prefixes; \
    test -s /opt/sharplabnext/.wine-prefix-layout.json; \
    python3 /usr/local/bin/sharplabnext-dedupe-wine-prefixes \
      --source /opt/wine-netfx-clr2 \
      --target /opt/wine-netfx-clr4 \
      --manifest /opt/sharplabnext/.wine-prefix-layout.json \
      --verify; \
    case "${NETFX_RUNTIME_VERSION}" in \
      2.0|3.0|3.5) /usr/local/bin/sharplabnext-wine-netfx-preflight /opt/wine-netfx-clr2 "${NETFX_RUNTIME_VERSION}" ;; \
      4.0|4.5|4.5.1|4.5.2|4.6|4.6.1|4.6.2|4.7|4.7.1|4.7.2|4.8) /usr/local/bin/sharplabnext-wine-netfx-preflight /opt/wine-netfx-clr4 "${NETFX_RUNTIME_VERSION}" ;; \
      *) printf 'Unsupported NETFX_RUNTIME_VERSION: %s\n' "${NETFX_RUNTIME_VERSION}" >&2; exit 1 ;; \
    esac; \
    test ! -e /usr/lib/x86_64-linux-gnu/wine/i386-windows

FROM ${CONTROL_IMAGE} AS control-image
RUN test -x /usr/share/dotnet/dotnet \
    && /usr/share/dotnet/dotnet --info >/dev/null

FROM wine-source AS runtime-base
ARG VERSION
ARG SOURCE_REVISION
ARG CANDIDATE_SOURCE_CONTEXT
ARG CANDIDATE_PROMOTION_ELIGIBLE
ARG PROFILE_ID
ARG NETFX_RUNTIME_VERSION
ARG RUNTIME_COMPONENT_DIGEST
ARG RUNTIME_COMPONENT_SOURCE_URI
ARG CONTROL_IMAGE
ARG WINE_IMAGE

RUN test -n "${VERSION}" \
    && test -n "${SOURCE_REVISION}" \
    && test -n "${PROFILE_ID}" \
    && test -n "${NETFX_RUNTIME_VERSION}" \
    && test -n "${RUNTIME_COMPONENT_SOURCE_URI}" \
    && printf '%s\n' "${RUNTIME_COMPONENT_DIGEST}" | grep -Eq '^sha256:[0-9a-f]{64}$' \
    && rm -rf /usr/share/dotnet \
    && mkdir -p /usr/share/dotnet /opt/sharplabnext/control-dotnet /workspace

# The operator image remains the runtime filesystem. Copy only the independently
# pinned control runtime; build-time execution below is the ABI compatibility
# check and does not require the two distributions to have identical text IDs.
COPY --from=control-image /usr/share/dotnet/ /usr/share/dotnet/
COPY --chmod=0555 deploy/docker/runtime-entrypoint.sh /opt/sharplabnext/runtime-entrypoint.sh
COPY --from=publish /target-runtime-runner/ /opt/sharplabnext/
COPY --from=publish /desktop-clr-jit-inspector/ /opt/sharplabnext/
COPY --from=publish /wine-runner/ /opt/sharplabnext/

RUN test -x /usr/bin/wine-stable \
    && test -x /usr/lib/wine/wine64 \
    && test -x /usr/lib/wine/wineserver64 \
    && test -d /opt/wine-netfx-clr2/drive_c/windows/Microsoft.NET/Framework64/v2.0.50727 \
    && test -f /opt/wine-netfx-clr2/drive_c/windows/Microsoft.NET/Framework64/v2.0.50727/mscorlib.dll \
    && test -d /opt/wine-netfx-clr4/drive_c/windows/Microsoft.NET/Framework64/v4.0.30319 \
    && test -f /opt/wine-netfx-clr4/drive_c/windows/Microsoft.NET/Framework64/v4.0.30319/mscorlib.dll \
    && test -x /usr/local/bin/sharplabnext-dedupe-wine-prefixes \
    && test -s /opt/sharplabnext/.wine-prefix-layout.json \
    && python3 /usr/local/bin/sharplabnext-dedupe-wine-prefixes \
         --source /opt/wine-netfx-clr2 \
         --target /opt/wine-netfx-clr4 \
         --manifest /opt/sharplabnext/.wine-prefix-layout.json \
         --verify \
    && /usr/local/bin/sharplabnext-wine-netfx-preflight \
         "$(case "${NETFX_RUNTIME_VERSION}" in 2.0|3.0|3.5) printf /opt/wine-netfx-clr2 ;; *) printf /opt/wine-netfx-clr4 ;; esac)" \
         "${NETFX_RUNTIME_VERSION}" \
    && test ! -e /usr/lib/x86_64-linux-gnu/wine/i386-windows \
    && test -x /usr/share/dotnet/dotnet \
    && ln -s /usr/share/dotnet/dotnet /opt/sharplabnext/control-dotnet/dotnet \
    && test -s /opt/sharplabnext/SharpLabNext.TargetRuntimeRunner.exe \
    && test -s /opt/sharplabnext/SharpLabNext.TargetRuntimeRunner.exe.config

ENV DOTNET_EnableDiagnostics=0 \
    COMPlus_EnableDiagnostics=0 \
    DOTNET_CLI_TELEMETRY_OPTOUT=1 \
    HOME=/tmp \
    WINEARCH=win64 \
    WINELOADER=/usr/lib/wine/wine64 \
    WINESERVER=/usr/lib/wine/wineserver64 \
    WINEDEBUG=-all \
    SHARPLABNEXT_CAPTURE_DIRECTORY="Z:\\tmp" \
    TEMP="Z:\\tmp" \
    TMP="Z:\\tmp"

FROM runtime-base AS preflight
ARG NETFX_RUNTIME_VERSION
RUN set -eu; \
    run_clean() { \
      stdout="$1"; stderr="$2"; shift 2; \
      if ! "$@" >"${stdout}" 2>"${stderr}"; then cat "${stderr}" >&2; return 1; fi; \
      if test -s "${stderr}"; then cat "${stderr}" >&2; return 1; fi; \
    }; \
    /usr/share/dotnet/dotnet --info >/dev/null; \
    prefix="$(case "${NETFX_RUNTIME_VERSION}" in 2.0|3.0|3.5) printf /opt/wine-netfx-clr2 ;; *) printf /opt/wine-netfx-clr4 ;; esac)"; \
    run_clean /tmp/target-runtime-runner.stdout /tmp/target-runtime-runner.stderr \
      env WINEPREFIX="${prefix}" /usr/lib/wine/wine64 \
      'Z:\\opt\\sharplabnext\\SharpLabNext.TargetRuntimeRunner.exe' self-test; \
    frames="$(cat /tmp/target-runtime-runner.stdout)"; \
    test "$(printf '%s\n' "${frames}" | grep --count .)" -eq 1; \
    install -d -m 0755 /workspace; \
    cp /opt/sharplabnext/SharpLabNext.DesktopClrJitInspector.exe* /workspace/; \
    run_clean /tmp/desktop-clr-jit.stdout /tmp/desktop-clr-jit.stderr \
      env WINEPREFIX="${prefix}" /usr/share/dotnet/dotnet \
      /opt/sharplabnext/SharpLabNext.WineRunner.dll \
      desktop-jit \
      /workspace/SharpLabNext.DesktopClrJitInspector.exe \
      WindowsAbi; \
    jit_frames="$(cat /tmp/desktop-clr-jit.stdout)"; \
    test "$(printf '%s\n' "${jit_frames}" | grep --count .)" -eq 3; \
    printf '%s\n' "${jit_frames}" | sed -n '1p' | base64 -d | grep -aq 'rcx'; \
    printf '%s\n' "${jit_frames}" | sed -n '1p' | base64 -d | grep -aq 'rdx'; \
    printf '%s\n' "${jit_frames}" | sed -n '1p' | base64 -d | grep -aq 'rax'; \
    printf '%s\n' "${jit_frames}" | sed -n '2p' | base64 -d | grep -aq 'RuntimeVersion'; \
    rm -f /workspace/SharpLabNext.DesktopClrJitInspector.exe*; \
    printf 'wine-framework-desktop-clr-jit-preflight-v1\n' > /runtime-image-preflight

FROM runtime-base AS final
ARG VERSION
ARG SOURCE_REVISION
ARG CANDIDATE_SOURCE_CONTEXT
ARG CANDIDATE_PROMOTION_ELIGIBLE
ARG PROFILE_ID
ARG NETFX_RUNTIME_VERSION
ARG RUNTIME_COMPONENT_DIGEST
ARG RUNTIME_COMPONENT_SOURCE_URI
ARG CONTROL_IMAGE
ARG WINE_IMAGE
COPY --from=preflight /runtime-image-preflight /opt/sharplabnext/.image-preflight

RUN test "${CANDIDATE_SOURCE_CONTEXT}:${CANDIDATE_PROMOTION_ELIGIBLE}" = "committed:true" \
    || test "${CANDIDATE_SOURCE_CONTEXT}:${CANDIDATE_PROMOTION_ELIGIBLE}" = "working-tree-development:false"

LABEL org.opencontainers.image.title="SharpLabNext Wine .NET Framework Matrix Runtime Candidate" \
      org.opencontainers.image.version="${VERSION}" \
      org.opencontainers.image.revision="${SOURCE_REVISION}" \
      io.sharplabnext.source.context="${CANDIDATE_SOURCE_CONTEXT}" \
      com.sharplabnext.runtime-candidate.promotion-eligible="${CANDIDATE_PROMOTION_ELIGIBLE}" \
      org.opencontainers.image.source="https://github.com/sharplabnext/SharpLabNext" \
      com.sharplabnext.runtime-candidate="true" \
      com.sharplabnext.runtime-profile="${PROFILE_ID}" \
      io.sharplabnext.runtime.environment="wine-netfx" \
      io.sharplabnext.runtime.framework-version="${NETFX_RUNTIME_VERSION}" \
      io.sharplabnext.runtime.component-digest="${RUNTIME_COMPONENT_DIGEST}" \
      io.sharplabnext.runtime.component-source-uri="${RUNTIME_COMPONENT_SOURCE_URI}" \
      io.sharplabnext.wine-prefix-layout="hardlink-immutable-v1" \
      io.sharplabnext.wine-prefix-layout-manifest="/opt/sharplabnext/.wine-prefix-layout.json" \
      io.sharplabnext.control-image="${CONTROL_IMAGE}" \
      io.sharplabnext.operator-image.wine="${WINE_IMAGE}"

WORKDIR /workspace
USER 0:0
ENTRYPOINT ["/opt/sharplabnext/runtime-entrypoint.sh"]
CMD ["/usr/lib/wine/wine64", "--version"]
