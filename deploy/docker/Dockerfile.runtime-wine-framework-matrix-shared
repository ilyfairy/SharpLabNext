# syntax=docker/dockerfile:1.7@sha256:a57df69d0ea827fb7266491f2813635de6f17269be881f696fbfdf2d83dda33e

# Exact Framework candidate derived from one shared operator parent.  The
# parent contains every row once; this image adds only directory whiteouts for
# unselected rows, one generation-specific canonical symlink, the shared runner, and the control
# runtime.  The selector receipt binds the selected row to the parent digest.

ARG SDK_IMAGE
ARG PARENT_IMAGE
ARG CONTROL_IMAGE
ARG CONTROL_TFM
ARG WINE_IMAGE
ARG FRAMEWORK_SOURCE_REVISION
ARG FRAMEWORK_MATRIX_INPUT_SHA256
ARG FRAMEWORK_MATRIX_SOURCE_URI
ARG FRAMEWORK_ROW_OPERATOR_IMAGE
ARG FRAMEWORK_ROW_DIGEST
ARG HISTORICAL_FRAMEWORK_INPUT_FOR_DEVELOPMENT

FROM ${SDK_IMAGE} AS publish
ARG SDK_IMAGE
ARG PARENT_IMAGE
ARG CONTROL_IMAGE
ARG SOURCE_REVISION
ARG CONTROL_TFM
WORKDIR /source
COPY deploy/docker/validate-digest-pinned-image.sh /usr/local/bin/sharplabnext-validate-image
RUN chmod 0555 /usr/local/bin/sharplabnext-validate-image \
    && /usr/local/bin/sharplabnext-validate-image \
         SDK_IMAGE "${SDK_IMAGE}" \
         PARENT_IMAGE "${PARENT_IMAGE}" \
         CONTROL_IMAGE "${CONTROL_IMAGE}"
COPY global.json Directory.Build.props Directory.Build.targets Directory.Packages.props NuGet.config SharpLabNext.slnx ./
COPY profiles/versions.props ./profiles/versions.props
COPY src/ ./src/
RUN dotnet restore \
      src/RuntimeJobs/SharpLabNext.TargetRuntimeRunner/SharpLabNext.TargetRuntimeRunner.csproj \
      --locked-mode \
    && dotnet restore \
      src/RuntimeJobs/SharpLabNext.DesktopClrJitInspector/SharpLabNext.DesktopClrJitInspector.csproj \
      --locked-mode \
    && dotnet restore \
      src/RuntimeJobs/SharpLabNext.WineRunner/SharpLabNext.WineRunner.csproj \
      --locked-mode
RUN dotnet publish \
      src/RuntimeJobs/SharpLabNext.TargetRuntimeRunner/SharpLabNext.TargetRuntimeRunner.csproj \
      --configuration Release \
      --framework net20 \
      --no-restore \
      --output /target-runtime-runner \
      /p:UseAppHost=false \
      /p:ContinuousIntegrationBuild=true \
      /p:SourceRevisionId=${SOURCE_REVISION}
RUN dotnet publish \
      src/RuntimeJobs/SharpLabNext.DesktopClrJitInspector/SharpLabNext.DesktopClrJitInspector.csproj \
      --configuration Release \
      --framework net20 \
      --no-restore \
      --output /desktop-clr-jit-inspector \
      /p:UseAppHost=false \
      /p:ContinuousIntegrationBuild=true \
      /p:SourceRevisionId=${SOURCE_REVISION} \
    && dotnet publish \
      src/RuntimeJobs/SharpLabNext.WineRunner/SharpLabNext.WineRunner.csproj \
      --configuration Release \
      --framework ${CONTROL_TFM} \
      --no-restore \
      --output /wine-runner \
      /p:UseAppHost=false \
      /p:ContinuousIntegrationBuild=true \
      /p:SourceRevisionId=${SOURCE_REVISION}

FROM ${PARENT_IMAGE} AS matrix-parent

FROM ${CONTROL_IMAGE} AS control-image
RUN test -x /usr/share/dotnet/dotnet \
    && /usr/share/dotnet/dotnet --info >/dev/null

FROM matrix-parent AS runtime-base
ARG VERSION
ARG SOURCE_REVISION
ARG CANDIDATE_SOURCE_CONTEXT
ARG CANDIDATE_PROMOTION_ELIGIBLE
ARG PROFILE_ID
ARG FRAMEWORK_TARGET_ID
ARG FRAMEWORK_RUNTIME_VERSION
ARG FRAMEWORK_CLR_GENERATION
ARG RUNTIME_COMPONENT_DIGEST
ARG RUNTIME_COMPONENT_SOURCE_URI
ARG CONTROL_IMAGE
ARG PARENT_IMAGE
ARG WINE_IMAGE
ARG FRAMEWORK_SOURCE_REVISION
ARG FRAMEWORK_MATRIX_INPUT_SHA256
ARG FRAMEWORK_MATRIX_SOURCE_URI
ARG FRAMEWORK_ROW_OPERATOR_IMAGE
ARG FRAMEWORK_ROW_DIGEST
ARG HISTORICAL_FRAMEWORK_INPUT_FOR_DEVELOPMENT

RUN set -euo pipefail; \
    test -n "${VERSION}"; \
    test -n "${SOURCE_REVISION}"; \
    [[ "${FRAMEWORK_SOURCE_REVISION}" =~ ^([0-9a-f]{40}|[0-9a-f]{64})$ ]]; \
    test "${HISTORICAL_FRAMEWORK_INPUT_FOR_DEVELOPMENT}" = true || test "${HISTORICAL_FRAMEWORK_INPUT_FOR_DEVELOPMENT}" = false; \
    if test "${HISTORICAL_FRAMEWORK_INPUT_FOR_DEVELOPMENT}" = true; then \
      test "${FRAMEWORK_SOURCE_REVISION}" != "${SOURCE_REVISION}"; \
    else \
      test "${FRAMEWORK_SOURCE_REVISION}" = "${SOURCE_REVISION}"; \
    fi; \
    test -n "${PROFILE_ID}"; \
    [[ "${FRAMEWORK_TARGET_ID}" =~ ^[a-z0-9][a-z0-9._-]{0,127}$ ]]; \
    [[ "${FRAMEWORK_RUNTIME_VERSION}" =~ ^[0-9]+(\.[0-9]+){1,2}$ ]]; \
    [[ "${FRAMEWORK_CLR_GENERATION}" =~ ^clr[24]$ ]]; \
    [[ "${PARENT_IMAGE}" =~ ^[^[:space:]@]+@sha256:[0-9a-f]{64}$ ]]; \
    printf '%s\n' "${RUNTIME_COMPONENT_DIGEST}" | grep -Eq '^sha256:[0-9a-f]{64}$'; \
    test -n "${RUNTIME_COMPONENT_SOURCE_URI}"; \
    [[ "${FRAMEWORK_ROW_OPERATOR_IMAGE}" =~ ^[^[:space:]@]+@sha256:[0-9a-f]{64}$ ]]; \
    [[ "${FRAMEWORK_ROW_DIGEST}" =~ ^sha256:[0-9a-f]{64}$ ]]; \
    operator_digest="${FRAMEWORK_ROW_OPERATOR_IMAGE##*@}"; \
    test "${RUNTIME_COMPONENT_DIGEST}" = "${operator_digest}"; \
    test "${RUNTIME_COMPONENT_SOURCE_URI}" = "docker://${FRAMEWORK_ROW_OPERATOR_IMAGE}"; \
    test -f /opt/sharplabnext/.operator-wine-image && test ! -L /opt/sharplabnext/.operator-wine-image; \
    test -f /opt/sharplabnext/.framework-matrix-input-sha256 && test ! -L /opt/sharplabnext/.framework-matrix-input-sha256; \
    test -f /opt/sharplabnext/.framework-matrix-source-uri && test ! -L /opt/sharplabnext/.framework-matrix-source-uri; \
    test "$(cat /opt/sharplabnext/.operator-wine-image)" = "${WINE_IMAGE}"; \
    test "$(cat /opt/sharplabnext/.framework-matrix-input-sha256)" = "${FRAMEWORK_MATRIX_INPUT_SHA256}"; \
    test "$(cat /opt/sharplabnext/.framework-matrix-source-uri)" = "${FRAMEWORK_MATRIX_SOURCE_URI}"; \
    test -s /opt/sharplabnext/framework-matrix.json; \
    test -s /opt/sharplabnext/.wine-prefix-layout.json; \
    test -x /usr/local/bin/sharplabnext-assemble-framework-prefix-matrix; \
    test -x /usr/local/bin/sharplabnext-dedupe-wine-prefixes; \
    mkdir -p /opt/sharplabnext; \
    canonical_prefix="/opt/wine-netfx-${FRAMEWORK_CLR_GENERATION}"; \
    other_prefix="$(case "${FRAMEWORK_CLR_GENERATION}" in clr2) printf /opt/wine-netfx-clr4 ;; clr4) printf /opt/wine-netfx-clr2 ;; esac)"; \
    /usr/local/bin/sharplabnext-assemble-framework-prefix-matrix select \
      --root /opt/sharplabnext/framework-prefixes \
      --target-id "${FRAMEWORK_TARGET_ID}" \
      --expected-version "${FRAMEWORK_RUNTIME_VERSION}" \
      --expected-generation "${FRAMEWORK_CLR_GENERATION}" \
      --canonical-prefix "${canonical_prefix}" \
      --receipt /opt/sharplabnext/.framework-selector.json \
      --dedupe-helper /usr/local/bin/sharplabnext-dedupe-wine-prefixes \
      --expected-input-manifest-sha256 "${FRAMEWORK_MATRIX_INPUT_SHA256}" \
      --expected-parent-image "${PARENT_IMAGE}" \
      --expected-operator-image "${FRAMEWORK_ROW_OPERATOR_IMAGE}" \
      --expected-row-digest "${FRAMEWORK_ROW_DIGEST}"; \
    test -L "${canonical_prefix}"; \
    test ! -e "${other_prefix}"; \
    test -s /opt/sharplabnext/.framework-selector.json

COPY --from=control-image /usr/share/dotnet/ /usr/share/dotnet/
COPY --from=publish /target-runtime-runner/ /opt/sharplabnext/
COPY --from=publish /desktop-clr-jit-inspector/ /opt/sharplabnext/
COPY --from=publish /wine-runner/ /opt/sharplabnext/
COPY --chmod=0555 deploy/docker/runtime-entrypoint.sh /opt/sharplabnext/runtime-entrypoint.sh

ENV DOTNET_EnableDiagnostics=0 \
    COMPlus_EnableDiagnostics=0 \
    DOTNET_CLI_TELEMETRY_OPTOUT=1 \
    HOME=/tmp \
    WINEARCH=win64 \
    WINELOADER=/usr/lib/wine/wine64 \
    WINESERVER=/usr/lib/wine/wineserver64 \
    WINEDEBUG=-all \
    SHARPLABNEXT_CAPTURE_DIRECTORY="Z:\\tmp" \
    TEMP="Z:\\tmp" \
    TMP="Z:\\tmp"

FROM runtime-base AS preflight
ARG FRAMEWORK_RUNTIME_VERSION
ARG FRAMEWORK_CLR_GENERATION
RUN set -eu; \
    prefix="$(case "${FRAMEWORK_CLR_GENERATION}" in clr2) printf /opt/wine-netfx-clr2 ;; clr4) printf /opt/wine-netfx-clr4 ;; esac)"; \
    /usr/local/bin/sharplabnext-wine-netfx-preflight "${prefix}" "${FRAMEWORK_RUNTIME_VERSION}"; \
    frames="$(WINEPREFIX="${prefix}" /usr/lib/wine/wine64 \
      'Z:\\opt\\sharplabnext\\SharpLabNext.TargetRuntimeRunner.exe' self-test)"; \
    test "$(printf '%s\n' "${frames}" | grep --count .)" -eq 1; \
    install -d -m 0755 /workspace; \
    cp /opt/sharplabnext/SharpLabNext.DesktopClrJitInspector.exe* /workspace/; \
    jit_frames="$(WINEPREFIX="${prefix}" /usr/share/dotnet/dotnet \
      /opt/sharplabnext/SharpLabNext.WineRunner.dll \
      desktop-jit \
      /workspace/SharpLabNext.DesktopClrJitInspector.exe \
      WindowsAbi)"; \
    test "$(printf '%s\n' "${jit_frames}" | grep --count .)" -eq 3; \
    printf '%s\n' "${jit_frames}" | sed -n '1p' | base64 -d | grep -aq 'rcx'; \
    printf '%s\n' "${jit_frames}" | sed -n '1p' | base64 -d | grep -aq 'rdx'; \
    printf '%s\n' "${jit_frames}" | sed -n '1p' | base64 -d | grep -aq 'rax'; \
    printf '%s\n' "${jit_frames}" | sed -n '2p' | base64 -d | grep -aq 'RuntimeVersion'; \
    rm -f /workspace/SharpLabNext.DesktopClrJitInspector.exe*; \
    printf 'wine-framework-desktop-clr-jit-preflight-v1\n' > /runtime-image-preflight

FROM runtime-base AS final
ARG VERSION
ARG SOURCE_REVISION
ARG CANDIDATE_SOURCE_CONTEXT
ARG CANDIDATE_PROMOTION_ELIGIBLE
ARG PROFILE_ID
ARG FRAMEWORK_TARGET_ID
ARG FRAMEWORK_RUNTIME_VERSION
ARG RUNTIME_COMPONENT_DIGEST
ARG RUNTIME_COMPONENT_SOURCE_URI
ARG CONTROL_IMAGE
ARG PARENT_IMAGE
ARG WINE_IMAGE
ARG FRAMEWORK_SOURCE_REVISION
ARG FRAMEWORK_MATRIX_INPUT_SHA256
ARG FRAMEWORK_MATRIX_SOURCE_URI
ARG FRAMEWORK_ROW_OPERATOR_IMAGE
ARG FRAMEWORK_ROW_DIGEST
ARG HISTORICAL_FRAMEWORK_INPUT_FOR_DEVELOPMENT
COPY --from=preflight /runtime-image-preflight /opt/sharplabnext/.image-preflight

RUN test "${CANDIDATE_SOURCE_CONTEXT}:${CANDIDATE_PROMOTION_ELIGIBLE}:${HISTORICAL_FRAMEWORK_INPUT_FOR_DEVELOPMENT}" = "committed:true:false" \
    || test "${CANDIDATE_SOURCE_CONTEXT}:${CANDIDATE_PROMOTION_ELIGIBLE}:${HISTORICAL_FRAMEWORK_INPUT_FOR_DEVELOPMENT}" = "working-tree-development:false:false" \
    || test "${CANDIDATE_SOURCE_CONTEXT}:${CANDIDATE_PROMOTION_ELIGIBLE}:${HISTORICAL_FRAMEWORK_INPUT_FOR_DEVELOPMENT}" = "committed-historical-framework-input-development:false:true" \
    || test "${CANDIDATE_SOURCE_CONTEXT}:${CANDIDATE_PROMOTION_ELIGIBLE}:${HISTORICAL_FRAMEWORK_INPUT_FOR_DEVELOPMENT}" = "working-tree-historical-framework-input-development:false:true"

LABEL org.opencontainers.image.title="SharpLabNext shared Wine .NET Framework runtime candidate" \
      org.opencontainers.image.version="${VERSION}" \
      org.opencontainers.image.revision="${SOURCE_REVISION}" \
      io.sharplabnext.source.context="${CANDIDATE_SOURCE_CONTEXT}" \
      com.sharplabnext.runtime-candidate.promotion-eligible="${CANDIDATE_PROMOTION_ELIGIBLE}" \
      com.sharplabnext.runtime-candidate="true" \
      com.sharplabnext.runtime-profile="${PROFILE_ID}" \
      io.sharplabnext.runtime.environment="wine-netfx" \
      io.sharplabnext.runtime.framework-version="${FRAMEWORK_RUNTIME_VERSION}" \
      io.sharplabnext.framework.target-id="${FRAMEWORK_TARGET_ID}" \
      io.sharplabnext.framework.matrix-parent="${PARENT_IMAGE}" \
      io.sharplabnext.framework.source-revision="${FRAMEWORK_SOURCE_REVISION}" \
      io.sharplabnext.operator-image.wine="${WINE_IMAGE}" \
      io.sharplabnext.framework.matrix-input-sha256="${FRAMEWORK_MATRIX_INPUT_SHA256}" \
      io.sharplabnext.framework.matrix-source-uri="${FRAMEWORK_MATRIX_SOURCE_URI}" \
      io.sharplabnext.framework.row-operator-image="${FRAMEWORK_ROW_OPERATOR_IMAGE}" \
      io.sharplabnext.framework.row-digest="${FRAMEWORK_ROW_DIGEST}" \
      io.sharplabnext.framework.matrix-selector="true" \
      io.sharplabnext.framework.selector="/opt/sharplabnext/.framework-selector.json" \
      io.sharplabnext.runtime.component-digest="${RUNTIME_COMPONENT_DIGEST}" \
      io.sharplabnext.runtime.component-source-uri="${RUNTIME_COMPONENT_SOURCE_URI}" \
      io.sharplabnext.control-image="${CONTROL_IMAGE}" \
      io.sharplabnext.wine-prefix-layout="hardlink-static-runtime-matrix-v1" \
      io.sharplabnext.framework.dedupe-policy="wine-static-runtime-payload-v1"

WORKDIR /workspace
USER 0:0
ENTRYPOINT ["/opt/sharplabnext/runtime-entrypoint.sh"]
CMD ["/usr/lib/wine/wine64", "--version"]
