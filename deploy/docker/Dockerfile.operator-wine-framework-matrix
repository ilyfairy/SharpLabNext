import os
import pathlib
import re
import stat
import sys

(seed_path, binding_path, target_id, seed_image, input_sha256,
 manifest_sha256, generation, version, prefix) = sys.argv[1:]

def read_bounded(path):
    info = os.lstat(path)
    if not stat.S_ISREG(info.st_mode) or info.st_size < 1 or info.st_size > 4096:
        raise ValueError
    return json.loads(pathlib.Path(path).read_text(encoding="utf-8"))

try:
    seed = read_bounded(seed_path)
    expected_seed = {
        "schemaVersion": 1,
        "strategy": "framework-companion-seed-v1",
        "seedInputSha256": input_sha256,
        "installerManifestSha256": manifest_sha256,
        "generation": generation,
        "version": version,
        "prefix": prefix,
    }
    if set(seed) != set(expected_seed) | {"wow64BaseImage"}:
        raise ValueError
    if any(seed[key] != expected_seed[key] for key in expected_seed):
        raise ValueError
    if re.fullmatch(r"[^\s@]+@sha256:[0-9a-f]{64}", seed["wow64BaseImage"]) is None:
        raise ValueError

    binding = read_bounded(binding_path)
    expected_binding = {
        "schemaVersion": 1,
        "strategy": "framework-companion-binding-v1",
        "targetId": target_id,
        "seedImage": seed_image,
        "seedInputSha256": input_sha256,
        "generation": generation,
        "version": version,
    }
    if binding != expected_binding:
        raise ValueError
except Exception:
    print("Framework companion seed binding verification failed.", file=sys.stderr)
    raise SystemExit(1) from None
PY

