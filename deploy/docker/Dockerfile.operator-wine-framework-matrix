FROM ${BASE_IMAGE} AS wine-source

SHELL ["/bin/bash", "-o", "pipefail", "-c"]

COPY profiles/runtime-framework-installers.json /usr/local/share/sharplabnext/runtime-framework-installers.json

# Framework installation needs a small tool closure that is deliberately not
# part of the deployable Wine userspace component. Resolve it from the same
# immutable, signed Ubuntu snapshot as the source operator and verify the exact
# package delta before any installer or downloaded Winetricks payload executes.
RUN <<'SH'
set -euo pipefail

manifest=/usr/local/share/sharplabnext/runtime-framework-installers.json
before=/tmp/sharplabnext-framework-bootstrap.before
after=/tmp/sharplabnext-framework-bootstrap.after
expected=/tmp/sharplabnext-framework-bootstrap.expected
actual=/tmp/sharplabnext-framework-bootstrap.actual
removed=/tmp/sharplabnext-framework-bootstrap.removed
cleanup() {
    rm -f "${before}" "${after}" "${expected}" "${actual}" "${removed}"
}
trap cleanup EXIT

test "$(find /etc/apt \( -name '*.list' -o -name '*.sources' \) -print)" = \
    '/etc/apt/sources.list.d/sharplabnext-snapshot.sources'
grep --fixed-strings --quiet '20260810T000000Z' \
    /etc/apt/sources.list.d/sharplabnext-snapshot.sources
dpkg-query -W -f='${binary:Package}=${Version}\n' | LC_ALL=C sort > "${before}"
apt-get update
printf '%s  %s\n' \
    'cdb2f31d809f589719a53c6ad15f255b27569c4059542ada282aaa21b8e164b0' \
    '/var/lib/apt/lists/snapshot.ubuntu.com_ubuntu_20260810T000000Z_dists_noble_InRelease' \
    'ef81441269d3a8bdd8cdfe9095de7deb7f1af70d42191f61f1af3c8fb72cfb32' \
    '/var/lib/apt/lists/snapshot.ubuntu.com_ubuntu_20260810T000000Z_dists_noble-updates_InRelease' \
    '3cfb1c8d7499c0bac1bfbe1e32675d200f0ca74b18afc4248c45325a073d0fd0' \
    '/var/lib/apt/lists/snapshot.ubuntu.com_ubuntu_20260810T000000Z_dists_noble-security_InRelease' \
    | sha256sum --check --strict
apt-get install --yes --no-install-recommends \
    python3=3.12.3-0ubuntu2.1 \
    cabextract=1.11-2 \
    winetricks=20240105-2

python3 - "${manifest}" "${expected}" <<'PY'
import hashlib
import json
import pathlib
import re
import sys

manifest_path, output_path = sys.argv[1:]
try:
    manifest = json.loads(pathlib.Path(manifest_path).read_text(encoding="utf-8"))
    tools = manifest["bootstrapTools"]
    if tools["archiveSnapshotId"] != "20260810T000000Z":
        raise ValueError
    if tools["directPackages"] != [
        {"name": "python3", "version": "3.12.3-0ubuntu2.1"},
        {"name": "cabextract", "version": "1.11-2"},
        {"name": "winetricks", "version": "20240105-2"},
    ]:
        raise ValueError
    packages = tools["resolvedPackages"]
    if (len(packages) != 28 or len(set(packages)) != 28 or
            packages != sorted(packages) or
            any(not isinstance(package, str) or not re.fullmatch(
                r"[a-z0-9][a-z0-9.+-]*(?::amd64)?=[A-Za-z0-9][A-Za-z0-9.+:~_-]*",
                package,
            ) for package in packages)):
        raise ValueError
    lock_bytes = "".join(f"{package}\n" for package in packages).encode("utf-8")
    if hashlib.sha256(lock_bytes).hexdigest() != tools["resolvedPackageListSha256"]:
        raise ValueError
    pathlib.Path(output_path).write_bytes(lock_bytes)
except Exception:
    print("Framework bootstrap tool manifest validation failed.", file=sys.stderr)
    raise SystemExit(1) from None
PY

dpkg-query -W -f='${binary:Package}=${Version}\n' | LC_ALL=C sort > "${after}"
