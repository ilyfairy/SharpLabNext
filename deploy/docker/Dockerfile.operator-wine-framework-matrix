# Re-root the operator on a small, independently pinned Linux image.  The Wine
# source image may contain a runtime prefix (for example /opt/wine-dotnet) and
# other operator payloads; copying only its userspace keeps those unrelated
# files out of every Framework operator image while preserving the exact Wine
# loader and the verified Framework bootstrap tool closure. The source and root
# share one pinned base, so its package database accurately describes /usr.
COPY --from=wine-source /usr/ /usr/
COPY --from=wine-source /etc/fonts/ /etc/fonts/
COPY --from=wine-source /etc/apt/sources.list.d/sharplabnext-snapshot.sources /etc/apt/sources.list.d/sharplabnext-snapshot.sources
COPY --from=wine-source /var/lib/dpkg/ /var/lib/dpkg/
COPY --from=wine-source /var/lib/apt/extended_states /var/lib/apt/extended_states

# Microsoft Framework installers include 32-bit bootstrap executables even for
# x64 payloads. Build the prefixes with a complete, transition-locked classic
# WoW64 userspace, then copy only /opt into the clean amd64 final stage below.
# No i386 package, Unix loader, or upgraded native library crosses that stage.
RUN <<'SH'
set -euo pipefail

manifest=/usr/local/share/sharplabnext/runtime-framework-installers.json
before=/tmp/sharplabnext-framework-wow64.before
after=/tmp/sharplabnext-framework-wow64.after
expected_replaced=/tmp/sharplabnext-framework-wow64.expected-replaced
expected_resolved=/tmp/sharplabnext-framework-wow64.expected-resolved
actual_replaced=/tmp/sharplabnext-framework-wow64.actual-replaced
actual_resolved=/tmp/sharplabnext-framework-wow64.actual-resolved
cleanup() {
    rm -f \
        "${before}" "${after}" \
        "${expected_replaced}" "${expected_resolved}" \
        "${actual_replaced}" "${actual_resolved}"
}
trap cleanup EXIT

find /etc/apt \( -name '*.list' -o -name '*.sources' \) \
    ! -path /etc/apt/sources.list.d/sharplabnext-snapshot.sources -delete
test "$(find /etc/apt \( -name '*.list' -o -name '*.sources' \) -print)" = \
    '/etc/apt/sources.list.d/sharplabnext-snapshot.sources'
test -z "$(dpkg --print-foreign-architectures)"
dpkg-query -W -f='${binary:Package}=${Version}\n' | LC_ALL=C sort > "${before}"
python3 - "${manifest}" "${expected_replaced}" "${expected_resolved}" <<'PY'
import hashlib
import json
import pathlib
import re
import sys

manifest_path, replaced_path, resolved_path = sys.argv[1:]
try:
    manifest = json.loads(pathlib.Path(manifest_path).read_text(encoding="utf-8"))
    installer = manifest["classicWow64Installer"]
    if installer["archiveSnapshotId"] != "20260810T000000Z":
        raise ValueError
    if installer["foreignArchitecture"] != "i386":
        raise ValueError
    if installer["directPackage"] != {
        "name": "wine32",
        "architecture": "i386",
        "version": "9.0~repack-4build3",
    }:
        raise ValueError
    package_pattern = re.compile(
        r"[a-z0-9][a-z0-9.+-]*(?::(?:amd64|i386))?="
        r"[A-Za-z0-9][A-Za-z0-9.+:~_-]*"
    )
    locks = [
        (
            "replacedPackages",
            "replacedPackageListSha256",
            4,
            "4a69f0e49c3ffd2cd0a5ef4001395cc5df87748ceb903a5595dea5872c3d1a45",
            pathlib.Path(replaced_path),
        ),
        (
            "resolvedPackages",
            "resolvedPackageListSha256",
            109,
            "e96dce12a7d0347874522dce2a520588fe4f3860feafd55a5736f11241b0ec8e",
            pathlib.Path(resolved_path),
        ),
    ]
    for packages_key, digest_key, count, expected_digest, output in locks:
        packages = installer[packages_key]
        if (len(packages) != count or len(set(packages)) != count or
                packages != sorted(packages) or
                any(not isinstance(package, str) or
                    package_pattern.fullmatch(package) is None
                    for package in packages)):
            raise ValueError
        lock_bytes = "".join(f"{package}\n" for package in packages).encode("utf-8")
        if (installer[digest_key] != expected_digest or
                hashlib.sha256(lock_bytes).hexdigest() != expected_digest):
            raise ValueError
        output.write_bytes(lock_bytes)
except Exception:
    print("Framework classic WoW64 package manifest validation failed.", file=sys.stderr)
    raise SystemExit(1) from None
