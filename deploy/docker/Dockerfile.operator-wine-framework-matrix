# syntax=docker/dockerfile:1.7

ARG BASE_IMAGE
ARG ROOT_IMAGE
FROM ${BASE_IMAGE} AS wine-source

FROM ${ROOT_IMAGE} AS final

ARG BASE_IMAGE
ARG ROOT_IMAGE
ARG FRAMEWORK_TARGET_ID
ARG FRAMEWORK_VERSION
ARG CLR_GENERATION
ARG INSTALLER_MANIFEST_SHA256
ARG ACCEPT_MICROSOFT_DOTNET_FRAMEWORK_EULA

SHELL ["/bin/bash", "-o", "pipefail", "-c"]

# Re-root the operator on a small, independently pinned Linux image.  The Wine
# source image may contain a runtime prefix (for example /opt/wine-dotnet) and
# other operator payloads; copying only its userspace keeps those unrelated
# files out of every Framework operator image while preserving the exact Wine
# loader, Winetricks and native library closure.
COPY --from=wine-source /usr/ /usr/
COPY --from=wine-source /etc/fonts/ /etc/fonts/

ENV WINEARCH=win64 \
    WINEDEBUG=-all \
    WINE=/usr/lib/wine/wine \
    WINELOADER=/usr/lib/wine/wine64 \
    WINESERVER=/usr/lib/wine/wineserver64

COPY profiles/runtime-framework-installers.json /usr/local/share/sharplabnext/runtime-framework-installers.json
COPY deploy/docker/wine-netfx-framework-preflight.sh /usr/local/bin/sharplabnext-wine-netfx-preflight
COPY deploy/docker/dedupe-wine-prefixes.py /usr/local/bin/sharplabnext-dedupe-wine-prefixes
COPY deploy/docker/certificates/microsoft-tls-rsa-root-g2-xsign.crt /usr/local/share/ca-certificates/
COPY deploy/docker/certificates/microsoft-tls-g2-rsa-ca-ocsp-04.crt /usr/local/share/ca-certificates/

RUN set -euo pipefail; \
    [[ "${BASE_IMAGE}" =~ ^[^[:space:]@]+@sha256:[0-9a-f]{64}$ ]]; \
    [[ "${ROOT_IMAGE}" =~ ^[^[:space:]@]+@sha256:[0-9a-f]{64}$ ]]; \
    test "$(openssl x509 -in /usr/local/share/ca-certificates/microsoft-tls-rsa-root-g2-xsign.crt -outform DER | sha256sum | awk '{ print $1 }')" = "ddcd1e8a20638d4aaff7201bb1d56452acd2c759f1686bdc38f73dd15732bdc2"; \
    test "$(openssl x509 -in /usr/local/share/ca-certificates/microsoft-tls-g2-rsa-ca-ocsp-04.crt -outform DER | sha256sum | awk '{ print $1 }')" = "ac8ea9f2874fd368a3e778b1a0b165ee898db9b9687c17edcdc76908ab58c82c"; \
    openssl verify -CAfile /etc/ssl/certs/ca-certificates.crt \
      /usr/local/share/ca-certificates/microsoft-tls-rsa-root-g2-xsign.crt; \
    openssl verify -CAfile /etc/ssl/certs/ca-certificates.crt \
      -untrusted /usr/local/share/ca-certificates/microsoft-tls-rsa-root-g2-xsign.crt \
      /usr/local/share/ca-certificates/microsoft-tls-g2-rsa-ca-ocsp-04.crt; \
    update-ca-certificates >/dev/null

RUN --mount=type=secret,id=framework-installer-url \
    --mount=type=bind,from=framework-installer-context,target=/run/operator-assets/framework <<'SH'
set -euo pipefail

fail_bootstrap() {
    printf '[framework-bootstrap] failed=%s\n' "$1" >&2
    exit 1
}

printf '[framework-bootstrap] stage=validate-inputs\n'
[[ "${BASE_IMAGE}" =~ ^[^[:space:]@]+@sha256:[0-9a-f]{64}$ ]] \
    || fail_bootstrap base-image
[[ "${FRAMEWORK_TARGET_ID}" =~ ^netfx[0-9]+$ ]] \
    || fail_bootstrap target-id
[[ "${FRAMEWORK_VERSION}" =~ ^[0-9]+(\.[0-9]+){1,2}$ ]] \
    || fail_bootstrap framework-version
[[ "${CLR_GENERATION}" =~ ^clr[24]$ ]] \
    || fail_bootstrap clr-generation
[[ "${INSTALLER_MANIFEST_SHA256}" =~ ^[0-9a-f]{64}$ ]] \
    || fail_bootstrap manifest-sha256
test "${ACCEPT_MICROSOFT_DOTNET_FRAMEWORK_EULA}" = "true" \
    || fail_bootstrap eula
for command in python3 sha256sum openssl winetricks cabextract xvfb-run timeout tail awk find; do
    command -v "${command}" >/dev/null || fail_bootstrap "tool-${command}"
done
test -x "${WINE}" || fail_bootstrap tool-wine
test -x "${WINELOADER}" || fail_bootstrap tool-wine-loader
test -x "${WINESERVER}" || fail_bootstrap tool-wineserver
test -x /usr/bin/wine-stable || fail_bootstrap tool-wine-stable

manifest=/usr/local/share/sharplabnext/runtime-framework-installers.json
printf '%s  %s\n' "${INSTALLER_MANIFEST_SHA256}" "${manifest}" | sha256sum --check --status - \
    || fail_bootstrap manifest-digest
chmod 0555 /usr/local/bin/sharplabnext-wine-netfx-preflight
chmod 0555 /usr/local/bin/sharplabnext-dedupe-wine-prefixes

installer_root="$(mktemp -d /tmp/sharplabnext-framework.XXXXXX)"
config_root="${installer_root}/config"
mkdir -p "${config_root}"
cleanup() {
    rm -rf "${installer_root}"
}
trap cleanup EXIT

python3 - "${manifest}" "${FRAMEWORK_TARGET_ID}" "${config_root}" <<'PY'
import json
import pathlib
import sys

manifest_path, target_id, output_path = sys.argv[1:]
try:
    manifest = json.loads(pathlib.Path(manifest_path).read_text(encoding="utf-8"))
    targets = [target for target in manifest["targets"] if target["id"] == target_id]
    if len(targets) != 1:
        raise ValueError
    target = targets[0]
    recipe = target["recipe"]
    companion = manifest["companionPrefixes"]
    values = {
        "winetricks-version": manifest["winetricksVersion"],
        "target-version": target["version"],
        "target-generation": target["clrGeneration"],
        "target-prefix": target["prefix"],
        "recipe-kind": recipe["kind"],
        "recipe-verb": recipe.get("verb", ""),
        "installer-file": recipe.get("fileName", ""),
        "installer-sha256": recipe.get("sha256", ""),
        "prerequisite-verb": recipe.get("prerequisiteVerb", ""),
        "clr2-prefix": companion["clr2"]["prefix"],
        "clr2-verb": companion["clr2"]["winetricksVerb"],
        "clr4-prefix": companion["clr4"]["prefix"],
        "clr4-verb": companion["clr4"]["winetricksVerb"],
    }
    output = pathlib.Path(output_path)
    for name, value in values.items():
        if not isinstance(value, str) or "\0" in value or "\n" in value or "\r" in value:
            raise ValueError
        (output / name).write_text(value, encoding="utf-8")
    arguments = recipe.get("arguments", [])
    if not isinstance(arguments, list) or any(not isinstance(argument, str) for argument in arguments):
        raise ValueError
    (output / "installer-arguments").write_text("".join(f"{argument}\n" for argument in arguments), encoding="utf-8")
except Exception:
    print("Framework installer manifest selection failed.", file=sys.stderr)
    raise SystemExit(1) from None
PY

read_config() {
    local value
    value="$(cat "${config_root}/$1")"
    test -n "${value}"
    printf '%s' "${value}"
}

winetricks_version="$(read_config winetricks-version)"
target_version="$(read_config target-version)"
target_generation="$(read_config target-generation)"
target_prefix="$(read_config target-prefix)"
recipe_kind="$(read_config recipe-kind)"
recipe_verb="$(cat "${config_root}/recipe-verb")"
installer_file="$(cat "${config_root}/installer-file")"
installer_sha256="$(cat "${config_root}/installer-sha256")"
prerequisite_verb="$(cat "${config_root}/prerequisite-verb")"
clr2_prefix="$(read_config clr2-prefix)"
clr2_verb="$(read_config clr2-verb)"
clr4_prefix="$(read_config clr4-prefix)"
clr4_verb="$(read_config clr4-verb)"
mapfile -t installer_arguments < "${config_root}/installer-arguments"

test "${target_version}" = "${FRAMEWORK_VERSION}" \
    || fail_bootstrap manifest-version
test "${target_generation}" = "${CLR_GENERATION}" \
    || fail_bootstrap manifest-generation
test "${clr2_prefix}" = /opt/wine-netfx-clr2 \
    || fail_bootstrap companion-clr2-prefix
test "${clr4_prefix}" = /opt/wine-netfx-clr4 \
    || fail_bootstrap companion-clr4-prefix
case "${target_generation}:${target_prefix}" in
    clr2:/opt/wine-netfx-clr2|clr4:/opt/wine-netfx-clr4) ;;
    *) fail_bootstrap target-prefix ;;
esac
for verb in "${clr2_verb}" "${clr4_verb}"; do
    [[ "${verb}" =~ ^dotnet[0-9]+(sp[0-9]+)?$ ]] \
        || fail_bootstrap companion-verb
done
actual_winetricks_version="$(winetricks --version | awk 'NR == 1 { print $1; exit }')"
test "${actual_winetricks_version}" = "${winetricks_version}" \
    || fail_bootstrap winetricks-version

stage() {
    printf '[framework-bootstrap] stage=%s\n' "$1"
}

bounded_log_tail() {
    tail -c 16384 "$1" | tail -n 80 | python3 -c '
import re
import sys

for line in sys.stdin:
    line = re.sub(r"https?://\S+", "<redacted-url>", line, flags=re.IGNORECASE)
    line = line.replace("/run/operator-assets/framework/installer.bin", "<operator-asset>")
    line = line.replace("/run/secrets/framework-installer-url", "<url-secret>")
    sys.stdout.write(line)
'
}

run_logged() {
    local operation="$1"
    shift
    local log="${installer_root}/${operation}.log"
    if "$@" >"${log}" 2>&1; then
        rm -f "${log}"
        return 0
    fi
    printf '[framework-bootstrap] failed=%s log-tail-bytes<=16384 log-tail-lines<=80\n' "${operation}" >&2
    bounded_log_tail "${log}" >&2 || true
    return 1
}

install_clean_winetricks() {
    local prefix="$1"
    local verb="$2"
    local operation="$3"
    local cache="${installer_root}/winetricks-cache-${operation}"
    rm -rf "${prefix}"
    mkdir -p "${prefix}" "${cache}"
    run_logged "${operation}" \
        env WINEPREFIX="${prefix}" WINEARCH=win64 W_CACHE="${cache}" \
        timeout --signal=KILL 1800 xvfb-run -a \
        winetricks --optout --unattended "${verb}"
    run_logged "${operation}-wineserver" \
        env WINEPREFIX="${prefix}" WINEARCH=win64 "${WINESERVER}" -w
    rm -rf "${cache}"
}

download_from_url_secret() {
    local destination="$1"
    python3 - /run/secrets/framework-installer-url "${destination}" <<'PY'
import shutil
import sys
import urllib.parse
import urllib.request

secret_path, destination = sys.argv[1:]
try:
    with open(secret_path, encoding="utf-8") as secret:
        url = secret.read().strip()
    parsed = urllib.parse.urlsplit(url)
    if parsed.scheme not in ("http", "https") or not parsed.netloc or any(character.isspace() for character in url):
        raise ValueError
    request = urllib.request.Request(url, headers={"User-Agent": "SharpLabNext-operator-bootstrap"})
    with urllib.request.urlopen(request, timeout=300) as response, open(destination, "xb") as output:
        shutil.copyfileobj(response, output, length=1024 * 1024)
except Exception:
    print("Operator asset download failed.", file=sys.stderr)
    raise SystemExit(1) from None
PY
}

materialize_operator_installer() {
    local destination="$1"
    local url_present=0
    local installer_present=0
    test -s /run/secrets/framework-installer-url && url_present=1
    test -s /run/operator-assets/framework/installer.bin && installer_present=1
    test "$((url_present + installer_present))" -eq 1
    if test "${installer_present}" -eq 1; then
        cp /run/operator-assets/framework/installer.bin "${destination}"
    else
        download_from_url_secret "${destination}"
    fi
}

install_manual_target() {
    [[ "${installer_file}" =~ ^[A-Za-z0-9][A-Za-z0-9._-]*\.exe$ ]]
    [[ "${installer_sha256}" =~ ^[0-9a-f]{64}$ ]]
    [[ "${prerequisite_verb}" =~ ^dotnet[0-9]+(sp[0-9]+)?$ ]]
    test "${#installer_arguments[@]}" -ge 1
    test "${#installer_arguments[@]}" -le 8
    for argument in "${installer_arguments[@]}"; do
        [[ "${argument}" =~ ^/[A-Za-z0-9:._=-]+$ ]]
    done

    install_clean_winetricks "${target_prefix}" "${prerequisite_verb}" target-prerequisite
    local installer="${installer_root}/${installer_file}"
    stage materialize-private-installer
    materialize_operator_installer "${installer}"
    printf '%s  %s\n' "${installer_sha256}" "${installer}" | sha256sum --check --status -
    run_logged install-target-manual \
        env WINEPREFIX="${target_prefix}" WINEARCH=win64 WINEDLLOVERRIDES=fusion=b \
        timeout --signal=KILL 1200 xvfb-run -a \
        /usr/bin/wine-stable "${installer}" "${installer_arguments[@]}"
    run_logged install-target-manual-wineserver \
        env WINEPREFIX="${target_prefix}" WINEARCH=win64 "${WINESERVER}" -w
    rm -f "${installer}"
}

url_present=0
installer_present=0
test -s /run/secrets/framework-installer-url && url_present=1
test -s /run/operator-assets/framework/installer.bin && installer_present=1
stage validate-recipe-source
case "${recipe_kind}" in
    winetricks)
        test "$((url_present + installer_present))" -eq 0
        [[ "${recipe_verb}" =~ ^dotnet[0-9]+(sp[0-9]+)?$ ]]
        test -z "${installer_file}${installer_sha256}${prerequisite_verb}"
        test "${#installer_arguments[@]}" -eq 0
        ;;
    operator-installer)
        test "$((url_present + installer_present))" -eq 1
        test -z "${recipe_verb}"
        ;;
    *) fail_bootstrap recipe-kind ;;
esac

if test "${target_generation}" = clr2; then
    stage install-target-clr2
    test "${recipe_kind}" = winetricks
    install_clean_winetricks "${target_prefix}" "${recipe_verb}" target-clr2
    stage install-companion-clr4
    install_clean_winetricks "${clr4_prefix}" "${clr4_verb}" companion-clr4
else
    stage install-companion-clr2
    install_clean_winetricks "${clr2_prefix}" "${clr2_verb}" companion-clr2
    stage install-target-clr4
    if test "${recipe_kind}" = winetricks; then
        install_clean_winetricks "${target_prefix}" "${recipe_verb}" target-clr4
    else
        install_manual_target
    fi
fi

stage preflight-installed-prefixes
if test "${target_generation}" = clr2; then
    /usr/local/bin/sharplabnext-wine-netfx-preflight "${clr2_prefix}" "${target_version}"
    /usr/local/bin/sharplabnext-wine-netfx-preflight "${clr4_prefix}" 4.8
else
    /usr/local/bin/sharplabnext-wine-netfx-preflight "${clr2_prefix}" 3.5
    /usr/local/bin/sharplabnext-wine-netfx-preflight "${clr4_prefix}" "${target_version}"
fi

stage cleanup-private-assets
for prefix in "${clr2_prefix}" "${clr4_prefix}"; do
    for temporary in \
        "${prefix}/drive_c/windows/temp" \
        "${prefix}/drive_c/users/root/Temp"; do
        if test -d "${temporary}"; then
            find "${temporary}" -mindepth 1 -maxdepth 1 -exec rm -rf -- {} +
        fi
    done
    find "${prefix}/drive_c/windows/Microsoft.NET" -type d -name SetupCache -prune -exec rm -rf -- {} +
    find "${prefix}" -type f \
        \( -iname 'dotnetfx*.exe' -o -iname 'netfx*.exe' -o -iname 'ndp*.exe' \) \
        -delete
done
stage deduplicate-immutable-prefix-files
python3 /usr/local/bin/sharplabnext-dedupe-wine-prefixes \
    --source /opt/wine-netfx-clr2 \
    --target /opt/wine-netfx-clr4 \
    --manifest /opt/sharplabnext/.wine-prefix-layout.json \
    --freeze
stage cleanup
cleanup
trap - EXIT
SH

RUN <<'SH'
set -euo pipefail

rm -rf /usr/lib/x86_64-linux-gnu/wine/i386-windows

fail_verify() {
    printf '[framework-verify] failed=%s\n' "$1" >&2
    exit 1
}

manifest=/usr/local/share/sharplabnext/runtime-framework-installers.json
printf '%s  %s\n' "${INSTALLER_MANIFEST_SHA256}" "${manifest}" | sha256sum --check --status - \
    || fail_verify manifest-digest
test -x /usr/local/bin/sharplabnext-wine-netfx-preflight \
    || fail_verify preflight-script
test -x /usr/local/bin/sharplabnext-dedupe-wine-prefixes \
    || fail_verify prefix-layout-script
test -s /opt/sharplabnext/.wine-prefix-layout.json \
    || fail_verify prefix-layout-manifest
python3 /usr/local/bin/sharplabnext-dedupe-wine-prefixes \
    --source /opt/wine-netfx-clr2 \
    --target /opt/wine-netfx-clr4 \
    --manifest /opt/sharplabnext/.wine-prefix-layout.json \
    --verify \
    || fail_verify prefix-layout
test ! -e /usr/lib/x86_64-linux-gnu/wine/i386-windows \
    || fail_verify i386-wine-payload

case "${CLR_GENERATION}:${FRAMEWORK_VERSION}" in
    clr2:2.0|clr2:3.0|clr2:3.5)
        /usr/local/bin/sharplabnext-wine-netfx-preflight /opt/wine-netfx-clr2 "${FRAMEWORK_VERSION}" \
            || fail_verify selected-clr2
        /usr/local/bin/sharplabnext-wine-netfx-preflight /opt/wine-netfx-clr4 4.8 \
            || fail_verify companion-clr4
        ;;
    clr4:4.0|clr4:4.5|clr4:4.5.1|clr4:4.5.2|clr4:4.6|clr4:4.6.1|clr4:4.6.2|clr4:4.7|clr4:4.7.1|clr4:4.7.2|clr4:4.8)
        /usr/local/bin/sharplabnext-wine-netfx-preflight /opt/wine-netfx-clr2 3.5 \
            || fail_verify companion-clr2
        /usr/local/bin/sharplabnext-wine-netfx-preflight /opt/wine-netfx-clr4 "${FRAMEWORK_VERSION}" \
            || fail_verify selected-clr4
        ;;
    *) fail_verify target-identity ;;
esac

if find /opt/wine-netfx-clr2 /opt/wine-netfx-clr4 -type d -name SetupCache -print -quit | grep -q .; then
    fail_verify setupcache-cleanup
fi
if find /opt/wine-netfx-clr2 /opt/wine-netfx-clr4 -type f \
    \( -iname 'dotnetfx*.exe' -o -iname 'netfx*.exe' -o -iname 'ndp*.exe' \) \
    -print -quit | grep -q .; then
    fail_verify private-installer-cleanup
fi
printf '[framework-verify] status=ok target=%s version=%s\n' \
    "${FRAMEWORK_TARGET_ID}" "${FRAMEWORK_VERSION}"
SH

LABEL org.opencontainers.image.title="SharpLabNext Operator Wine .NET Framework Matrix" \
      org.opencontainers.image.version="${FRAMEWORK_VERSION}" \
      io.sharplabnext.runtime.framework=".NETFramework,Version=v${FRAMEWORK_VERSION}" \
      io.sharplabnext.runtime.framework-version="${FRAMEWORK_VERSION}" \
      io.sharplabnext.operator-only="true" \
      io.sharplabnext.redistribution="operator-supplied-only" \
      io.sharplabnext.framework.target-id="${FRAMEWORK_TARGET_ID}" \
      io.sharplabnext.framework.version="${FRAMEWORK_VERSION}" \
      io.sharplabnext.framework.clr-generation="${CLR_GENERATION}" \
      io.sharplabnext.framework.installer-manifest-sha256="${INSTALLER_MANIFEST_SHA256}" \
      io.sharplabnext.wine-prefix-layout="hardlink-immutable-v1" \
      io.sharplabnext.wine-prefix-layout-manifest="/opt/sharplabnext/.wine-prefix-layout.json" \
      io.sharplabnext.operator-base="${BASE_IMAGE}" \
      io.sharplabnext.operator-root="${ROOT_IMAGE}"

WORKDIR /opt
USER 0:0
