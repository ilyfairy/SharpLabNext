# syntax=docker/dockerfile:1.7@sha256:a57df69d0ea827fb7266491f2813635de6f17269be881f696fbfdf2d83dda33e

ARG FRAMEWORK_SEED_IMAGE
FROM ${FRAMEWORK_SEED_IMAGE} AS final

ARG FRAMEWORK_SEED_IMAGE
ARG JSHARP_INSTALLER_SHA256
ARG OPERATOR_BUILD_INPUT_SHA256
ARG ACCEPT_MICROSOFT_DOTNET_EULA
ARG ACCEPT_MICROSOFT_JSHARP_EULA

SHELL ["/bin/bash", "-o", "pipefail", "-c"]

ENV WINEPREFIX=/opt/wine-jsharp20 \
    WINEARCH=win64 \
    WINEDEBUG=-all

RUN --mount=type=bind,from=visual-jsharp-installer-context,target=/run/operator-assets/visual-jsharp,ro <<'SH'
set -euo pipefail

[[ "${FRAMEWORK_SEED_IMAGE}" =~ ^[^[:space:]@]+@sha256:[0-9a-f]{64}$ ]]
[[ "${JSHARP_INSTALLER_SHA256}" =~ ^[0-9a-f]{64}$ ]]
[[ "${OPERATOR_BUILD_INPUT_SHA256}" =~ ^[0-9a-f]{64}$ ]]
test "${ACCEPT_MICROSOFT_DOTNET_EULA}" = true
test "${ACCEPT_MICROSOFT_JSHARP_EULA}" = true
for command in python3 sha256sum cabextract xvfb-run wine-stable timeout objdump tail; do
    command -v "${command}" >/dev/null
done
test -x /usr/lib/wine/wineserver
seed_prefix=/opt/wine-netfx-clr2
test -d "${seed_prefix}"
test ! -e "${WINEPREFIX}"
test "$(
    find /run/operator-assets/visual-jsharp \
        -mindepth 1 -maxdepth 1 -type f -printf '%f\n'
)" = vjredist64.exe

installer=/run/operator-assets/visual-jsharp/vjredist64.exe
printf '%s  %s\n' "${JSHARP_INSTALLER_SHA256}" "${installer}" \
    | sha256sum --check --strict

work="$(mktemp -d /tmp/sharplabnext-jsharp20.XXXXXX)"
cleanup() {
    rm -rf "${work}"
}
trap cleanup EXIT

stage() {
    printf '[jsharp-bootstrap] stage=%s\n' "$1"
}

bounded_log_tail() {
    tail -c 16384 "$1" | tail -n 80 | python3 -c '
import re
import sys

for line in sys.stdin:
    line = re.sub(r"https?://\S+", "<redacted-url>", line, flags=re.IGNORECASE)
    line = line.replace(
        "/run/operator-assets/visual-jsharp/vjredist64.exe",
        "<repository-lfs-input>",
    )
    sys.stdout.write(line)
'
}

run_logged() {
    local operation="$1"
    shift
    local log="${work}/${operation}.log"
    if "$@" >"${log}" 2>&1; then
        rm -f "${log}"
        return 0
    fi
    printf '[jsharp-bootstrap] failed=%s log-tail-bytes<=16384 log-tail-lines<=80\n' \
        "${operation}" >&2
    bounded_log_tail "${log}" >&2 || true
    return 1
}

stage extract-jsharp
extract="${work}/visual-jsharp-se-x64"
mkdir -p "${extract}"
run_logged extract-jsharp-cab cabextract -q -d "${extract}" "${installer}"
jsharp_bootstrap="$(find "${extract}" -type f -iname install.exe -print -quit)"
test -n "${jsharp_bootstrap}"

install_jsharp() {
    cd "$(dirname "${jsharp_bootstrap}")"
    WINEPREFIX="${seed_prefix}" timeout --signal=KILL 600 xvfb-run -a \
        wine-stable "$(basename "${jsharp_bootstrap}")" /q
}

stage install-jsharp
run_logged install-jsharp-bootstrap install_jsharp
run_logged install-jsharp-wineserver \
    env WINEPREFIX="${seed_prefix}" /usr/lib/wine/wineserver -w

stage preflight-framework-seed
/usr/local/bin/sharplabnext-wine-netfx-preflight "${seed_prefix}" 3.5

stage bind-jsharp-prefix
mv "${seed_prefix}" "${WINEPREFIX}"
test ! -e "${seed_prefix}"

stage cleanup-private-assets
for temporary in \
    "${WINEPREFIX}/drive_c/windows/temp" \
    "${WINEPREFIX}/drive_c/users/root/Temp"; do
    if test -d "${temporary}"; then
        find "${temporary}" -mindepth 1 -maxdepth 1 -exec rm -rf -- {} +
    fi
done
find "${WINEPREFIX}" -type d -name SetupCache -prune -exec rm -rf -- {} +
find "${WINEPREFIX}" -type f \
    \( -iname 'vjredist*.exe' -o -iname 'visual-jsharp-*-installer.exe' \) \
    -delete
stage cleanup
cleanup
trap - EXIT
SH

RUN set -euo pipefail <<'SH'
fail_verify() {
    printf '[jsharp-verify] failed=%s\n' "$1" >&2
    exit 1
}

require_file() {
    test -f "$2" || fail_verify "$1"
}

require_x64() {
    if ! objdump -f "$2" 2>/dev/null | grep -Fq 'architecture: i386:x86-64'; then
        fail_verify "$1"
    fi
}

require_ilonly_neutral() {
    python3 - "$2" <<'PY' || fail_verify "$1"
import struct
import sys

try:
    data = open(sys.argv[1], "rb").read()
    pe = struct.unpack_from("<I", data, 0x3C)[0]
    if data[pe:pe + 4] != b"PE\0\0":
        raise ValueError
    machine = struct.unpack_from("<H", data, pe + 4)[0]
    optional_size = struct.unpack_from("<H", data, pe + 20)[0]
    optional = pe + 24
    if machine != 0x14C or struct.unpack_from("<H", data, optional)[0] != 0x10B:
        raise ValueError
    section_count = struct.unpack_from("<H", data, pe + 6)[0]
    cli_directory = optional + 96 + (14 * 8)
    cli_rva, cli_size = struct.unpack_from("<II", data, cli_directory)
    if cli_rva == 0 or cli_size < 72:
        raise ValueError
    section_table = optional + optional_size
    cli_offset = None
    for index in range(section_count):
        section = section_table + (index * 40)
        virtual_size, virtual_address, raw_size, raw_offset = struct.unpack_from(
            "<IIII", data, section + 8)
        if virtual_address <= cli_rva < virtual_address + max(virtual_size, raw_size):
            cli_offset = raw_offset + (cli_rva - virtual_address)
            break
    if cli_offset is None:
        raise ValueError
    flags = struct.unpack_from("<I", data, cli_offset + 16)[0]
    if flags & 0x1 == 0 or flags & (0x2 | 0x10 | 0x20000):
        raise ValueError
except Exception:
    raise SystemExit(1) from None
PY
}

link_export() {
    if ! ln -s "$2" "$3" 2>/dev/null; then
        fail_verify "$1"
    fi
}

framework64="${WINEPREFIX}/drive_c/windows/Microsoft.NET/Framework64/v2.0.50727"
require_file framework64-mscorwks "${framework64}/mscorwks.dll"
require_file framework64-mscorlib "${framework64}/mscorlib.dll"
require_file framework64-vjc "${framework64}/vjc.exe"
require_file framework64-vjc-config "${framework64}/vjc.exe.config"
require_file framework64-vjsc "${framework64}/vjsc.dll"
require_file framework64-vjslib "${framework64}/vjslib.dll"
require_file framework64-vjscor "${framework64}/vjscor.dll"
if ! tr -d '\000' < "${framework64}/vjc.exe.config" | grep -Fq 'v2.0.50727'; then
    fail_verify config-vjc-clr2
fi
require_x64 arch-mscorwks "${framework64}/mscorwks.dll"
require_x64 arch-vjc "${framework64}/vjc.exe"
require_x64 arch-vjsc "${framework64}/vjsc.dll"
require_x64 arch-vjslib "${framework64}/vjslib.dll"
require_ilonly_neutral neutral-ilonly-vjscor "${framework64}/vjscor.dll"

gac64="${WINEPREFIX}/drive_c/windows/assembly/GAC_64"
gac64_vjslib="$(find "${gac64}" -type f -iname vjslib.dll -print -quit 2>/dev/null || true)"
test -n "${gac64_vjslib}" || fail_verify gac64-vjslib-runtime
require_x64 arch-gac64-vjslib "${gac64_vjslib}"

vjsnativ="${framework64}/vjsnativ.dll"
require_file framework64-vjsnativ "${vjsnativ}"
require_x64 arch-vjsnativ "${vjsnativ}"

operator_toolchain=/opt/sharplabnext/jsharp20
mkdir -p "${operator_toolchain}" || fail_verify export-directory
link_export export-vjc "${framework64}/vjc.exe" "${operator_toolchain}/vjc.exe"
link_export export-vjsc "${framework64}/vjsc.dll" "${operator_toolchain}/vjsc.dll"
link_export export-vjslib "${framework64}/vjslib.dll" "${operator_toolchain}/vjslib.dll"
link_export export-vjscor "${framework64}/vjscor.dll" "${operator_toolchain}/vjscor.dll"
link_export export-vjsnativ "${vjsnativ}" "${operator_toolchain}/vjsnativ.dll"

if remaining_installer="$(find "${WINEPREFIX}" -type f \
    \( -iname 'vjredist*.exe' -o -iname 'visual-jsharp-*-installer.exe' \) \
    -print -quit 2>/dev/null)" && test -n "${remaining_installer}"; then
    fail_verify private-installer-cleanup
fi
printf '[jsharp-verify] status=ok\n'
SH

LABEL org.opencontainers.image.title="SharpLabNext Source-Built Visual J# 2.0 SE x64 Toolchain" \
      io.sharplabnext.operator-build.strategy="source-built-operator-image-v1" \
      io.sharplabnext.operator-build.input-sha256="${OPERATOR_BUILD_INPUT_SHA256}" \
      io.sharplabnext.operator-build.image-id="jsharp20-development-base" \
      io.sharplabnext.operator-build.build-kind="jsharp20" \
      io.sharplabnext.operator-build.framework-seed-image="${FRAMEWORK_SEED_IMAGE}" \
      io.sharplabnext.operator-only="true" \
      io.sharplabnext.redistribution="operator-supplied-only"

WORKDIR /opt/sharplabnext/jsharp20
USER 0:0
