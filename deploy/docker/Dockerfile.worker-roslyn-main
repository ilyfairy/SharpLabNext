# syntax=docker/dockerfile:1.7@sha256:a57df69d0ea827fb7266491f2813635de6f17269be881f696fbfdf2d83dda33e

ARG SDK_IMAGE
ARG ASPNET_IMAGE
ARG ROSLYN_MAIN_COMMIT
ARG ROSLYN_MAIN_ARCHIVE_URL
ARG ROSLYN_MAIN_ARCHIVE_SHA256
ARG ROSLYN_MAIN_VERSION
ARG NET10_REFERENCE_PACK_VERSION
ARG NET10_REFERENCE_URL
ARG NET10_REFERENCE_SHA512
ARG NET10_REFERENCE_PACKAGE_CONTENT_HASH
ARG NET11_REFERENCE_VERSION
ARG NET11_REFERENCE_URL
ARG NET11_REFERENCE_SHA512
ARG NET11_REFERENCE_PACKAGE_CONTENT_HASH

FROM ${SDK_IMAGE} AS roslyn-main
ARG ROSLYN_MAIN_COMMIT
ARG ROSLYN_MAIN_ARCHIVE_URL
ARG ROSLYN_MAIN_ARCHIVE_SHA256
ARG ROSLYN_MAIN_VERSION
WORKDIR /roslyn-source
RUN curl --fail --location --retry 3 --retry-all-errors --output /tmp/roslyn-main.tar.gz "${ROSLYN_MAIN_ARCHIVE_URL}" \
    && echo "${ROSLYN_MAIN_ARCHIVE_SHA256}  /tmp/roslyn-main.tar.gz" | sha256sum --check --strict \
    && tar --extract --gzip --file /tmp/roslyn-main.tar.gz --strip-components=1 \
    && rm /tmp/roslyn-main.tar.gz
COPY eng/roslyn-main.slnf ./SharpLabNext.Roslyn.Main.slnf
RUN --mount=type=cache,id=sharplabnext-roslyn-main-nuget,target=/root/.nuget/packages,sharing=locked \
    ./build.sh \
      --restore \
      --configuration Release \
      --solution SharpLabNext.Roslyn.Main.slnf \
      /p:OfficialBuild=true \
      /p:SourceRevisionId=${ROSLYN_MAIN_COMMIT} \
      /p:ContinuousIntegrationBuild=true \
      /p:RestoreUseStaticGraphEvaluation=false \
      /p:RestoreDisableParallel=false \
      /p:UseSharedCompilation=false \
      /p:UsingToolVisualStudioIbcTraining=false
RUN set -eux; \
    mkdir /roslyn-main; \
    for name in \
      Microsoft.CodeAnalysis \
      Microsoft.CodeAnalysis.CSharp \
      Microsoft.CodeAnalysis.VisualBasic \
      Microsoft.CodeAnalysis.Workspaces \
      Microsoft.CodeAnalysis.CSharp.Workspaces \
      Microsoft.CodeAnalysis.VisualBasic.Workspaces \
      Microsoft.CodeAnalysis.Features \
      Microsoft.CodeAnalysis.CSharp.Features \
      Microsoft.CodeAnalysis.VisualBasic.Features \
      Microsoft.CodeAnalysis.Scripting; \
    do \
      cp "artifacts/bin/${name}/Release/net10.0/${name}.dll" /roslyn-main/; \
    done
COPY eng/tools/verify-roslyn-main.cs /tools/verify-roslyn-main.cs
COPY eng/NuGet.verifier.config /tools/NuGet.verifier.config
WORKDIR /tools
RUN --network=none \
    dotnet restore /tools/verify-roslyn-main.cs \
      --configfile /tools/NuGet.verifier.config \
      -p:NuGetAudit=false \
    && dotnet run --no-restore /tools/verify-roslyn-main.cs -- \
      /roslyn-main "${ROSLYN_MAIN_VERSION}" "${ROSLYN_MAIN_COMMIT}"

FROM ${SDK_IMAGE} AS publish
ARG CONFIGURATION=Release
ARG NETCOREAPP20_REFERENCE_VERSION
ARG NETCOREAPP20_REFERENCE_SOURCE_URI
ARG NETCOREAPP20_REFERENCE_SHA512
ARG NETCOREAPP20_REFERENCE_PACKAGE_CONTENT_HASH
ARG NETCOREAPP21_REFERENCE_VERSION
ARG NETCOREAPP21_REFERENCE_SOURCE_URI
ARG NETCOREAPP21_REFERENCE_SHA512
ARG NETCOREAPP21_REFERENCE_PACKAGE_CONTENT_HASH
ARG NETCOREAPP22_REFERENCE_VERSION
ARG NETCOREAPP22_REFERENCE_SOURCE_URI
ARG NETCOREAPP22_REFERENCE_SHA512
ARG NETCOREAPP22_REFERENCE_PACKAGE_CONTENT_HASH
ARG NETCOREAPP30_REFERENCE_VERSION
ARG NETCOREAPP30_REFERENCE_SOURCE_URI
ARG NETCOREAPP30_REFERENCE_SHA512
ARG NETCOREAPP30_REFERENCE_PACKAGE_CONTENT_HASH
ARG NETCOREAPP31_REFERENCE_VERSION
ARG NETCOREAPP31_REFERENCE_SOURCE_URI
ARG NETCOREAPP31_REFERENCE_SHA512
ARG NETCOREAPP31_REFERENCE_PACKAGE_CONTENT_HASH
ARG NET5_REFERENCE_VERSION
ARG NET5_REFERENCE_SOURCE_URI
ARG NET5_REFERENCE_SHA512
ARG NET5_REFERENCE_PACKAGE_CONTENT_HASH
ARG NET6_REFERENCE_VERSION
ARG NET6_REFERENCE_SOURCE_URI
ARG NET6_REFERENCE_SHA512
ARG NET6_REFERENCE_PACKAGE_CONTENT_HASH
ARG NET7_REFERENCE_VERSION
ARG NET7_REFERENCE_SOURCE_URI
ARG NET7_REFERENCE_SHA512
ARG NET7_REFERENCE_PACKAGE_CONTENT_HASH
ARG NET8_REFERENCE_VERSION
ARG NET8_REFERENCE_SOURCE_URI
ARG NET8_REFERENCE_SHA512
ARG NET8_REFERENCE_PACKAGE_CONTENT_HASH
ARG NET9_REFERENCE_VERSION
ARG NET9_REFERENCE_SOURCE_URI
ARG NET9_REFERENCE_SHA512
ARG NET9_REFERENCE_PACKAGE_CONTENT_HASH
ARG NET10_REFERENCE_PACK_VERSION
ARG NET10_REFERENCE_URL
ARG NET10_REFERENCE_SHA512
ARG NET10_REFERENCE_PACKAGE_CONTENT_HASH
ARG NET11_REFERENCE_VERSION
ARG NET11_REFERENCE_URL
ARG NET11_REFERENCE_SHA512
ARG NET11_REFERENCE_PACKAGE_CONTENT_HASH
WORKDIR /source
COPY global.json Directory.Build.props Directory.Build.targets Directory.Packages.props NuGet.config SharpLabNext.slnx ./
COPY profiles/versions.props ./profiles/versions.props
COPY profiles/runtime-matrix.json /inputs/runtime-matrix.json
COPY profiles/lock.json /inputs/lock.json
COPY src/ ./src/
COPY eng/tools/materialize-coreclr-reference-sets.cs /tools/materialize-coreclr-reference-sets.cs
COPY --from=roslyn-main /roslyn-main/ /roslyn-main/
RUN --mount=type=cache,id=sharplabnext-dotnet-nuget,target=/root/.nuget/packages,sharing=locked \
    dotnet restore \
      src/Workers/Roslyn.Main/SharpLabNext.Worker.Roslyn.Main/SharpLabNext.Worker.Roslyn.Main.csproj \
      --locked-mode \
      /p:RoslynMainSourceBuild=true \
      /p:RoslynMainAssemblyDirectory=/roslyn-main \
    && dotnet publish \
      src/Workers/Roslyn.Main/SharpLabNext.Worker.Roslyn.Main/SharpLabNext.Worker.Roslyn.Main.csproj \
      --configuration ${CONFIGURATION} \
      --no-restore \
      --output /app/publish \
      /p:UseAppHost=false \
      /p:RoslynMainSourceBuild=true \
      /p:RoslynMainAssemblyDirectory=/roslyn-main
RUN --mount=type=cache,id=sharplabnext-dotnet-nuget,target=/root/.nuget/packages,sharing=locked \
    dotnet restore \
      src/RuntimeApi/SharpLabNext.Runtime/SharpLabNext.Runtime.csproj \
      --locked-mode \
    && dotnet build --no-restore \
      src/RuntimeApi/SharpLabNext.Runtime/SharpLabNext.Runtime.csproj \
      --configuration "${CONFIGURATION}" \
      --framework netstandard2.1 \
      --output /app/sharplab-runtime-netstandard21 \
    && test -f /app/sharplab-runtime-netstandard21/SharpLab.Runtime.dll
RUN --mount=type=cache,id=sharplabnext-reference-archives,target=/reference-archives,sharing=locked \
    test -f /app/sharplab-runtime-netstandard21/SharpLab.Runtime.dll \
    && cd /tools \
    && NUGET_PACKAGES=/tmp/reference-nuget dotnet run materialize-coreclr-reference-sets.cs -- \
      --matrix /inputs/runtime-matrix.json \
      --lock /inputs/lock.json \
      --output /reference-sets \
      --archive-cache /reference-archives \
      --appsettings-template /source/src/Workers/Roslyn.Main/SharpLabNext.Worker.Roslyn.Main/appsettings.json \
      --appsettings-output /generated/appsettings.json \
      --runtime-assembly /app/sharplab-runtime-netstandard21/SharpLab.Runtime.dll \
      --netcoreapp20-version "${NETCOREAPP20_REFERENCE_VERSION}" \
      --netcoreapp20-url "${NETCOREAPP20_REFERENCE_SOURCE_URI}" \
      --netcoreapp20-sha512 "${NETCOREAPP20_REFERENCE_SHA512}" \
      --netcoreapp20-content-hash "${NETCOREAPP20_REFERENCE_PACKAGE_CONTENT_HASH}" \
      --netcoreapp21-version "${NETCOREAPP21_REFERENCE_VERSION}" \
      --netcoreapp21-url "${NETCOREAPP21_REFERENCE_SOURCE_URI}" \
      --netcoreapp21-sha512 "${NETCOREAPP21_REFERENCE_SHA512}" \
      --netcoreapp21-content-hash "${NETCOREAPP21_REFERENCE_PACKAGE_CONTENT_HASH}" \
      --netcoreapp22-version "${NETCOREAPP22_REFERENCE_VERSION}" \
      --netcoreapp22-url "${NETCOREAPP22_REFERENCE_SOURCE_URI}" \
      --netcoreapp22-sha512 "${NETCOREAPP22_REFERENCE_SHA512}" \
      --netcoreapp22-content-hash "${NETCOREAPP22_REFERENCE_PACKAGE_CONTENT_HASH}" \
      --netcoreapp30-version "${NETCOREAPP30_REFERENCE_VERSION}" \
      --netcoreapp30-url "${NETCOREAPP30_REFERENCE_SOURCE_URI}" \
      --netcoreapp30-sha512 "${NETCOREAPP30_REFERENCE_SHA512}" \
      --netcoreapp30-content-hash "${NETCOREAPP30_REFERENCE_PACKAGE_CONTENT_HASH}" \
      --netcoreapp31-version "${NETCOREAPP31_REFERENCE_VERSION}" \
      --netcoreapp31-url "${NETCOREAPP31_REFERENCE_SOURCE_URI}" \
      --netcoreapp31-sha512 "${NETCOREAPP31_REFERENCE_SHA512}" \
      --netcoreapp31-content-hash "${NETCOREAPP31_REFERENCE_PACKAGE_CONTENT_HASH}" \
      --net5-version "${NET5_REFERENCE_VERSION}" \
      --net5-url "${NET5_REFERENCE_SOURCE_URI}" \
      --net5-sha512 "${NET5_REFERENCE_SHA512}" \
      --net5-content-hash "${NET5_REFERENCE_PACKAGE_CONTENT_HASH}" \
      --net6-version "${NET6_REFERENCE_VERSION}" \
      --net6-url "${NET6_REFERENCE_SOURCE_URI}" \
      --net6-sha512 "${NET6_REFERENCE_SHA512}" \
      --net6-content-hash "${NET6_REFERENCE_PACKAGE_CONTENT_HASH}" \
      --net7-version "${NET7_REFERENCE_VERSION}" \
      --net7-url "${NET7_REFERENCE_SOURCE_URI}" \
      --net7-sha512 "${NET7_REFERENCE_SHA512}" \
      --net7-content-hash "${NET7_REFERENCE_PACKAGE_CONTENT_HASH}" \
      --net8-version "${NET8_REFERENCE_VERSION}" \
      --net8-url "${NET8_REFERENCE_SOURCE_URI}" \
      --net8-sha512 "${NET8_REFERENCE_SHA512}" \
      --net8-content-hash "${NET8_REFERENCE_PACKAGE_CONTENT_HASH}" \
      --net9-version "${NET9_REFERENCE_VERSION}" \
      --net9-url "${NET9_REFERENCE_SOURCE_URI}" \
      --net9-sha512 "${NET9_REFERENCE_SHA512}" \
      --net9-content-hash "${NET9_REFERENCE_PACKAGE_CONTENT_HASH}" \
      --net10-version "${NET10_REFERENCE_PACK_VERSION}" \
      --net10-url "${NET10_REFERENCE_URL}" \
      --net10-sha512 "${NET10_REFERENCE_SHA512}" \
      --net10-content-hash "${NET10_REFERENCE_PACKAGE_CONTENT_HASH}" \
      --net11-version "${NET11_REFERENCE_VERSION}" \
      --net11-url "${NET11_REFERENCE_URL}" \
      --net11-sha512 "${NET11_REFERENCE_SHA512}" \
      --net11-content-hash "${NET11_REFERENCE_PACKAGE_CONTENT_HASH}" \
    && test "$(find /reference-sets -mindepth 1 -maxdepth 1 -type d | wc -l)" -eq 12 \
    && test "$(find /reference-sets -name reference-set.attestation.json -type f | wc -l)" -eq 12 \
    && test -f /reference-sets/netcoreapp2.0-ref/System.Runtime.dll \
    && test -f /reference-sets/net11-preview-ref/SharpLab.Runtime.dll

FROM ${ASPNET_IMAGE} AS final
ARG VERSION
ARG SOURCE_REVISION
ARG ROSLYN_MAIN_COMMIT
ARG ROSLYN_MAIN_VERSION
ARG NET10_REFERENCE_PACKAGE_CONTENT_HASH
ARG NET11_REFERENCE_PACKAGE_CONTENT_HASH
RUN mkdir -p /var/lib/sharplabnext \
    && chown 1654:1654 /var/lib/sharplabnext
LABEL org.opencontainers.image.title="SharpLabNext Roslyn Main Worker" \
      org.opencontainers.image.version="${VERSION}" \
      org.opencontainers.image.revision="${SOURCE_REVISION}" \
      org.opencontainers.image.source="https://github.com/sharplabnext/SharpLabNext" \
      io.sharplabnext.roslyn.commit="${ROSLYN_MAIN_COMMIT}" \
      io.sharplabnext.reference-set.net10-ref="${NET10_REFERENCE_PACKAGE_CONTENT_HASH}" \
      io.sharplabnext.reference-set.net11-preview-ref="${NET11_REFERENCE_PACKAGE_CONTENT_HASH}"
WORKDIR /app
ENV ASPNETCORE_URLS=http://+:8080 \
    DOTNET_EnableDiagnostics=0 \
    COMPlus_EnableDiagnostics=0 \
    HOME=/tmp \
    RoslynWorker__CompilerVersion=${ROSLYN_MAIN_VERSION} \
    RoslynWorker__CompilerCommit=${ROSLYN_MAIN_COMMIT} \
    SHARPLABNEXT_ASSEMBLY=SharpLabNext.Worker.Roslyn.Main.dll
COPY --from=publish --chown=1654:1654 /app/publish/ ./
COPY --from=publish --chown=1654:1654 /reference-sets/ /reference-sets/
COPY --from=publish --chown=1654:1654 /generated/appsettings.json /app/appsettings.json
COPY --chmod=0555 deploy/docker/service-entrypoint.sh /usr/local/bin/sharplabnext-service
USER 1654:1654
EXPOSE 8080
ENTRYPOINT ["/usr/local/bin/sharplabnext-service"]
