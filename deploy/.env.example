SHARPLABNEXT_RUNTIME_SUPERVISOR_IMAGE=sharplabnext/runtime-supervisor:content
SHARPLABNEXT_DOTNET10_RUNTIME_IMAGE=sharplabnext/runtime-dotnet10:content

# Image IDs are generated from `docker image inspect` into a release bundle.
# Keep these placeholders for direct local configuration; do not hand-copy
# local SHA-256 values into this file.
