SHARPLABNEXT_ROSLYN_CONST_GENERICS_IMAGE=sharplabnext/worker-roslyn-const-generics:content
SHARPLABNEXT_ROSLYN_CONST_GENERICS_IMAGE_ID=
SHARPLABNEXT_FSHARP_IMAGE_ID=
SHARPLABNEXT_IL_WORKER_IMAGE_ID=
SHARPLABNEXT_MINILANG_IMAGE_ID=
SHARPLABNEXT_ARTIFACTS_DEFAULT_IMAGE=sharplabnext/worker-artifacts-default:content
SHARPLABNEXT_ARTIFACTS_CONST_GENERICS_IMAGE=sharplabnext/worker-artifacts-const-generics:content
SHARPLABNEXT_ARTIFACTS_CONST_GENERICS_IMAGE_ID=
