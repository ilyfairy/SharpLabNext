SHARPLABNEXT_RELEASE_ID=content
SHARPLABNEXT_BIND_ADDRESS=0.0.0.0
SHARPLABNEXT_HTTP_PORT=8080
DOCKER_GID=0

SHARPLABNEXT_GATEWAY_IMAGE=sharplabnext/gateway:content
