{
  "schemaVersion": 1,
  "capabilityDefinitions": [
    {
      "id": "wine",
      "dependencies": [],
      "provisioner": {
        "kind": "wine-operator"
      },
      "runtimeArguments": [
        { "option": "--wine-image", "sourceCapability": "wine", "output": "localTag" }
      ]
    },
    {
      "id": "framework",
      "dependencies": ["wine"],
      "provisioner": {
        "kind": "framework-matrix",
        "requiresPrerequisites": true,
        "requiresRegistry": true,
        "seedGenerations": []
      },
      "runtimeArguments": [
        { "option": "--wine-image", "sourceCapability": "wine", "output": "digest" },
        { "option": "--framework-input", "sourceCapability": "framework", "output": "candidateInput" }
      ]
    },
    {
      "id": "jsharp",
      "dependencies": ["framework"],
      "operator": {
        "imageId": "jsharp20-development-base",
        "buildKind": "jsharp20",
        "script": "eng/tools/prepare-jsharp-toolchain.cs",
        "frameworkSeedGeneration": "clr2",
        "environmentVariable": "JSHARP_TOOLCHAIN_IMAGE",
        "downloadArguments": [],
        "licenseArguments": ["--accept-microsoft-dotnet-eula", "--accept-microsoft-jsharp-eula"],
        "inputFiles": ["deploy/docker/Dockerfile.operator-jsharp20"]
      }
    },
    {
      "id": "cppcli",
      "dependencies": ["framework"],
      "operator": {
        "imageId": "cppcli-prepared-base",
        "buildKind": "cppcli",
        "script": "eng/tools/prepare-cppcli-toolchain.cs",
        "frameworkSeedGeneration": "clr4",
        "environmentVariable": "CPPCLI_PREPARED_BASE_IMAGE",
        "downloadArguments": [
          { "option": "--msvc-wine-source", "downloadId": "msvc-wine-source" },
          { "option": "--visual-studio-manifest", "downloadId": "visual-studio-manifest" },
          { "option": "--netfx48-developer-pack", "downloadId": "netfx48-developer-pack" }
        ],
        "licenseArguments": ["--accept-microsoft-cpp-build-tools-license", "--accept-microsoft-dotnet-eula"],
        "inputFiles": ["deploy/docker/Dockerfile.operator-cppcli-base", "deploy/docker/cppcli-netfx-env.sh", "deploy/docker/extract-netfx48-sdk.py"]
      }
    }
  ],
