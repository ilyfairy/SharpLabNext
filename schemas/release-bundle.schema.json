{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.sharplabnext.dev/releases/v1/release-bundle.schema.json",
  "title": "SharpLabNext Offline Release Bundle",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "releaseId", "createdAt", "platform", "containsImages", "hasSignature", "source", "images"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "releaseId": { "$ref": "#/$defs/releaseId" },
    "createdAt": { "type": "string", "format": "date-time" },
    "platform": { "const": "linux/amd64" },
    "containsImages": { "type": "boolean" },
    "hasSignature": { "type": "boolean" },
    "source": { "$ref": "#/$defs/source" },
    "signatureAlgorithm": { "enum": ["ed25519"] },
    "signatureKeyId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "signingPublicKeySha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "images": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/image" }
    }
  },
  "$defs": {
    "nonEmpty": { "type": "string", "minLength": 1, "maxLength": 512 },
    "releaseId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-z0-9][a-z0-9._-]*$" },
    "sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["revision", "dirty", "verified"],
      "properties": {
        "revision": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        },
        "headRevision": {
          "type": "string",
          "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
        },
        "dirty": { "type": "boolean" },
        "verified": { "type": "boolean" }
      }
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "sourceReference", "imageId", "operatingSystem", "architecture", "repoDigests"],
      "dependentRequired": {
        "runtimeCommit": ["runtimeId", "jitCommit"],
        "jitCommit": ["runtimeId", "runtimeCommit"]
      },
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "sourceReference": { "$ref": "#/$defs/nonEmpty" },
        "imageId": { "$ref": "#/$defs/sha256" },
        "operatingSystem": { "const": "linux" },
        "architecture": { "const": "amd64" },
        "repoDigests": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "@sha256:[0-9a-f]{64}$" }
        },
        "composeService": { "$ref": "#/$defs/id" },
        "runtimeId": { "$ref": "#/$defs/id" },
        "runtimeCommit": { "type": "string", "minLength": 7, "maxLength": 64, "pattern": "^[0-9a-f]+$" },
        "jitCommit": { "type": "string", "minLength": 7, "maxLength": 64, "pattern": "^[0-9a-f]+$" }
      }
    }
  }
}
