{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.sharplabnext.dev/workers/v1/artifact-worker-capability.schema.json",
  "title": "SharpLabNext Artifact Worker Capability Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "workerId",
    "protocolVersion",
    "capabilities",
    "acceptedArtifactFormats",
    "producedArtifactFormats",
    "transformIds",
    "renderOutputIds",
    "verificationProfileIds",
    "limits"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "workerId": { "$ref": "#/$defs/id" },
    "protocolVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+$" },
    "capabilities": { "$ref": "#/$defs/nonEmptyIds" },
    "acceptedArtifactFormats": { "$ref": "#/$defs/nonEmptyIds" },
    "producedArtifactFormats": { "$ref": "#/$defs/nonEmptyIds" },
    "transformIds": { "$ref": "#/$defs/ids" },
    "renderOutputIds": { "$ref": "#/$defs/ids" },
    "verificationProfileIds": { "$ref": "#/$defs/ids" },
    "limits": { "$ref": "#/$defs/limits" }
  },
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z0-9][a-z0-9._-]*$"
    },
    "ids": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/id" }
    },
    "nonEmptyIds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/id" }
    },
    "positive": { "type": "integer", "minimum": 1 },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "maximumInputArtifactBytes",
        "maximumOutputArtifactBytes",
        "maximumConcurrentOperations",
        "maximumOperationMilliseconds",
        "maximumRetainedOperations",
        "maximumEventsPerOperation"
      ],
      "properties": {
        "maximumInputArtifactBytes": { "$ref": "#/$defs/positive" },
        "maximumOutputArtifactBytes": { "$ref": "#/$defs/positive" },
        "maximumConcurrentOperations": { "$ref": "#/$defs/positive" },
        "maximumOperationMilliseconds": { "$ref": "#/$defs/positive" },
        "maximumRetainedOperations": { "$ref": "#/$defs/positive" },
        "maximumEventsPerOperation": { "type": "integer", "minimum": 8 }
      }
    }
  }
}
