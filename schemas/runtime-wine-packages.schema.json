{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.sharplabnext.dev/runtime/v1/runtime-wine-packages.schema.json",
  "title": "SharpLabNext Source-Controlled Wine Userspace",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "platform",
    "baseImageId",
    "component",
    "archiveSnapshots",
    "directPackages",
    "resolvedPackages",
    "sourcePackages",
    "resolvedPackageListSha256",
    "sourceOffer",
    "noticeArchive"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "platform": { "const": "linux/amd64" },
    "baseImageId": { "const": "dotnet-runtime-deps" },
    "component": { "$ref": "#/$defs/component" },
    "archiveSnapshots": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": { "$ref": "#/$defs/archiveSnapshot" }
    },
    "directPackages": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": { "$ref": "#/$defs/directPackage" }
    },
    "resolvedPackages": {
      "type": "array",
      "minItems": 228,
      "maxItems": 228,
      "items": { "$ref": "#/$defs/resolvedPackage" }
    },
    "sourcePackages": {
      "type": "array",
      "minItems": 162,
      "maxItems": 162,
      "items": { "$ref": "#/$defs/sourcePackage" }
    },
    "resolvedPackageListSha256": {
      "const": "sha256:fa83c245764fc09102029b249f5149a48baeda53a40c0432de973ebe09e39dee"
    },
    "sourceOffer": { "$ref": "#/$defs/sourceOffer" },
    "noticeArchive": { "$ref": "#/$defs/noticeArchive" }
  },
  "$defs": {
    "nonEmpty": { "type": "string", "minLength": 1, "maxLength": 512 },
    "packageName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z0-9][a-z0-9+._:-]*$"
    },
    "sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "sha256Hex": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "uri": { "type": "string", "format": "uri", "maxLength": 2048 },
    "poolPath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^pool/(main|universe|restricted|multiverse)/[A-Za-z0-9~.+_:%/-]+$"
    },
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "resolvedVersion", "license", "sourceUri"],
      "properties": {
        "id": { "const": "wine-coreclr-userspace" },
        "kind": { "const": "runtime-dependency" },
        "resolvedVersion": { "const": "wine-9.0~repack-4build3+xvfb-2:21.1.12-1ubuntu1.6" },
        "license": { "const": "LGPL-2.1+" },
        "sourceUri": { "const": "https://snapshot.ubuntu.com/ubuntu/20260810T000000Z/" }
      }
    },
    "archiveSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["purpose", "id", "uri", "suites"],
      "properties": {
        "purpose": { "enum": ["operator-installation", "base-image-package-evidence"] },
        "id": { "type": "string", "pattern": "^[0-9]{8}T[0-9]{6}Z$" },
        "uri": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://snapshot\\.ubuntu\\.com/ubuntu/[0-9]{8}T[0-9]{6}Z/$"
        },
        "suites": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "items": { "$ref": "#/$defs/archiveSnapshotSuite" }
        }
      }
    },
    "archiveSnapshotSuite": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "inReleaseSha256",
        "inReleaseSizeBytes",
        "signingKeyFingerprint",
        "indexes"
      ],
      "properties": {
        "name": { "enum": ["noble", "noble-updates", "noble-security"] },
        "inReleaseSha256": { "$ref": "#/$defs/sha256Hex" },
        "inReleaseSizeBytes": { "type": "integer", "minimum": 1 },
        "signingKeyFingerprint": { "const": "F6ECB3762474EDA9D21B7022871920D1991BC93C" },
        "indexes": {
          "type": "array",
          "minItems": 8,
          "maxItems": 8,
          "items": { "$ref": "#/$defs/archiveIndex" }
        }
      }
    },
    "archiveIndex": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "component", "path", "sha256", "sizeBytes"],
      "properties": {
        "kind": { "enum": ["binary", "source"] },
        "component": { "enum": ["main", "universe", "restricted", "multiverse"] },
        "architecture": { "const": "amd64" },
        "path": {
          "type": "string",
          "pattern": "^(main|universe|restricted|multiverse)/(binary-amd64/Packages|source/Sources)\\.(gz|xz)$"
        },
        "sha256": { "$ref": "#/$defs/sha256Hex" },
        "sizeBytes": { "type": "integer", "minimum": 1 }
      }
    },
    "directPackage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version",
        "architecture",
        "path",
        "sha256",
        "sourcePackage",
        "license",
        "sourceUri",
        "sourceSha256",
        "sourceSizeBytes"
      ],
      "properties": {
        "name": { "$ref": "#/$defs/packageName" },
        "version": { "$ref": "#/$defs/nonEmpty" },
        "architecture": { "enum": ["all", "amd64"] },
        "path": { "$ref": "#/$defs/poolPath" },
        "sha256": { "$ref": "#/$defs/sha256Hex" },
        "sourcePackage": { "$ref": "#/$defs/packageName" },
        "license": { "enum": ["LGPL-2.1+", "MIT"] },
        "sourceUri": { "$ref": "#/$defs/uri" },
        "sourceSha256": { "$ref": "#/$defs/sha256Hex" },
        "sourceSizeBytes": { "type": "integer", "minimum": 1 }
      }
    },
    "resolvedPackage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version",
        "architecture",
        "archiveSnapshotId",
        "archiveSuite",
        "archiveComponent",
        "archiveIndexPath",
        "path",
        "sha256",
        "sizeBytes",
        "sourcePackage",
        "sourceVersion",
        "copyrightPath",
        "copyrightSha256",
        "copyrightSizeBytes"
      ],
      "properties": {
        "name": { "$ref": "#/$defs/packageName" },
        "version": { "$ref": "#/$defs/nonEmpty" },
        "architecture": { "enum": ["all", "amd64"] },
        "archiveSnapshotId": { "type": "string", "pattern": "^[0-9]{8}T[0-9]{6}Z$" },
        "archiveSuite": { "enum": ["noble", "noble-updates", "noble-security"] },
        "archiveComponent": { "enum": ["main", "universe", "restricted", "multiverse"] },
        "archiveIndexPath": {
          "type": "string",
          "pattern": "^(main|universe|restricted|multiverse)/binary-amd64/Packages\\.(gz|xz)$"
        },
        "path": { "$ref": "#/$defs/poolPath" },
        "sha256": { "$ref": "#/$defs/sha256Hex" },
        "sizeBytes": { "type": "integer", "minimum": 1 },
        "sourcePackage": { "$ref": "#/$defs/packageName" },
        "sourceVersion": { "$ref": "#/$defs/nonEmpty" },
        "copyrightPath": {
          "type": "string",
          "pattern": "^/usr/share/doc/[A-Za-z0-9][A-Za-z0-9.+_-]*/copyright$"
        },
        "copyrightSha256": { "$ref": "#/$defs/sha256Hex" },
        "copyrightSizeBytes": { "type": "integer", "minimum": 1 }
      }
    },
    "sourcePackage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version",
        "archiveSnapshotId",
        "archiveSuite",
        "archiveComponent",
        "archiveIndexPath",
        "files"
      ],
      "properties": {
        "name": { "$ref": "#/$defs/packageName" },
        "version": { "$ref": "#/$defs/nonEmpty" },
        "archiveSnapshotId": { "type": "string", "pattern": "^[0-9]{8}T[0-9]{6}Z$" },
        "archiveSuite": { "enum": ["noble", "noble-updates", "noble-security"] },
        "archiveComponent": { "enum": ["main", "universe", "restricted", "multiverse"] },
        "archiveIndexPath": {
          "type": "string",
          "pattern": "^(main|universe|restricted|multiverse)/source/Sources\\.(gz|xz)$"
        },
        "files": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": { "$ref": "#/$defs/sourcePackageFile" }
        }
      }
    },
    "sourcePackageFile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "sizeBytes"],
      "properties": {
        "path": { "$ref": "#/$defs/poolPath" },
        "sha256": { "$ref": "#/$defs/sha256Hex" },
        "sizeBytes": { "type": "integer", "minimum": 1, "maximum": 268435456 }
      }
    },
    "sourceOffer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["baseUri", "package", "version", "license", "files"],
      "properties": {
        "baseUri": { "const": "https://snapshot.ubuntu.com/ubuntu/20260810T000000Z/pool/universe/w/wine/" },
        "package": { "const": "wine" },
        "version": { "const": "9.0~repack-4build3" },
        "license": { "const": "LGPL-2.1+" },
        "files": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": { "$ref": "#/$defs/sourceOfferFile" }
        }
      }
    },
    "sourceOfferFile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "sizeBytes"],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512,
          "pattern": "^wine_[A-Za-z0-9~.+-]+\\.(dsc|tar\\.xz)$"
        },
        "sha256": { "$ref": "#/$defs/sha256Hex" },
        "sizeBytes": { "type": "integer", "minimum": 1 }
      }
    },
    "noticeArchive": {
      "type": "object",
      "additionalProperties": false,
      "required": ["imagePath", "sha256", "sizeBytes", "entryCount"],
      "properties": {
        "imagePath": { "const": "/usr/local/share/sharplabnext/wine-coreclr-copyright-notices.tar" },
        "sha256": { "const": "3fcd04a992da99ac8fb08d3b7aa5a3ac29f28d9de221f7bc37c455c431e27f8d" },
        "sizeBytes": { "const": 2887680 },
        "entryCount": { "const": 225 }
      }
    }
  }
}
