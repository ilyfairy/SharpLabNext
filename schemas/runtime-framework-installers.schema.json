{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.sharplabnext.dev/runtime/v1/runtime-framework-installers.schema.json",
  "title": "SharpLabNext Operator .NET Framework Installer Recipes",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "winetricksVersion",
    "vendoredWinetricksPayloads",
    "cachedWinetricksPayloads",
    "bootstrapTools",
    "classicWow64Installer",
    "companionPrefixes",
    "targets"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "winetricksVersion": { "type": "string", "pattern": "^[0-9]{8}$" },
    "vendoredWinetricksPayloads": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": { "$ref": "#/$defs/vendoredWinetricksPayload" }
    },
    "cachedWinetricksPayloads": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": { "$ref": "#/$defs/cachedWinetricksPayload" }
    },
    "bootstrapTools": { "$ref": "#/$defs/bootstrapTools" },
    "classicWow64Installer": { "$ref": "#/$defs/classicWow64Installer" },
    "companionPrefixes": { "$ref": "#/$defs/companionPrefixes" },
    "targets": {
      "type": "array",
      "minItems": 14,
      "maxItems": 14,
      "items": { "$ref": "#/$defs/target" }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^netfx[0-9]+$"
    },
    "version": {
      "enum": [
        "2.0",
        "3.0",
        "3.5",
        "4.0",
        "4.5",
        "4.5.1",
        "4.5.2",
        "4.6",
        "4.6.1",
        "4.6.2",
        "4.7",
        "4.7.1",
        "4.7.2",
        "4.8"
      ]
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "vendoredWinetricksPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "verb",
        "repositoryPath",
        "cachePath",
        "sizeBytes",
        "sha256"
      ],
      "properties": {
        "id": { "const": "dotnet20-x64" },
        "verb": { "const": "dotnet20" },
        "repositoryPath": {
          "const": "eng/prerequisites/dotnet-framework-2.0/NetFx64.exe"
        },
        "cachePath": { "const": "dotnet20/NetFx64.exe" },
        "sizeBytes": { "const": 47400128 },
        "sha256": {
          "const": "7ea86dca8eeaedcaa4a17370547ca2cea9e9b6774972b8e03d2cb1fb0e798669"
        }
      }
    },
    "cachedWinetricksPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "verb",
        "prerequisiteId",
        "cachePath",
        "sizeBytes",
        "sha256"
      ],
      "properties": {
        "id": { "const": "dotnet35sp1-full" },
        "verb": { "const": "dotnet35sp1" },
        "prerequisiteId": { "const": "netfx35sp1-installer" },
        "cachePath": { "const": "dotnet35sp1/dotnetfx35.exe" },
        "sizeBytes": { "const": 242743296 },
        "sha256": {
          "const": "0582515bde321e072f8673e829e175ed2e7a53e803127c50253af76528e66bc1"
        }
      }
    },
    "bootstrapDirectPackage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": { "enum": ["python3", "cabextract", "winetricks"] },
        "version": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9.+:~_-]*$"
        }
      }
    },
    "packageLockEntry": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9.+-]*(?::(?:amd64|i386))?=[A-Za-z0-9][A-Za-z0-9.+:~_-]*$"
    },
    "bootstrapTools": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "archiveSnapshotId",
        "directPackages",
        "resolvedPackages",
        "resolvedPackageListSha256"
      ],
      "properties": {
        "archiveSnapshotId": { "const": "20260810T000000Z" },
        "directPackages": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": { "$ref": "#/$defs/bootstrapDirectPackage" }
        },
        "resolvedPackages": {
          "type": "array",
          "minItems": 28,
          "maxItems": 28,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/packageLockEntry" }
        },
        "resolvedPackageListSha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "classicWow64DirectPackage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "architecture", "version"],
      "properties": {
        "name": { "const": "wine32" },
        "architecture": { "const": "i386" },
        "version": { "const": "9.0~repack-4build3" }
      }
    },
    "classicWow64Installer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "archiveSnapshotId",
        "foreignArchitecture",
        "directPackage",
        "replacedPackages",
        "replacedPackageListSha256",
        "resolvedPackages",
        "resolvedPackageListSha256"
      ],
      "properties": {
        "archiveSnapshotId": { "const": "20260810T000000Z" },
        "foreignArchitecture": { "const": "i386" },
        "directPackage": { "$ref": "#/$defs/classicWow64DirectPackage" },
        "replacedPackages": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/packageLockEntry" }
        },
        "replacedPackageListSha256": { "$ref": "#/$defs/sha256" },
        "resolvedPackages": {
          "type": "array",
          "minItems": 109,
          "maxItems": 109,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/packageLockEntry" }
        },
        "resolvedPackageListSha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "winetricksVerb": {
      "type": "string",
      "pattern": "^dotnet[0-9]+(?:sp[0-9]+)?$"
    },
    "prefix": {
      "enum": [
        "/opt/wine-netfx-clr2",
        "/opt/wine-netfx-clr4"
      ]
    },
    "companionPrefix": {
      "type": "object",
      "additionalProperties": false,
      "required": ["prefix", "winetricksVerb"],
      "properties": {
        "prefix": { "$ref": "#/$defs/prefix" },
        "winetricksVerb": { "$ref": "#/$defs/winetricksVerb" }
      }
    },
    "companionPrefixes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["clr2", "clr4"],
      "properties": {
        "clr2": { "$ref": "#/$defs/companionPrefix" },
        "clr4": { "$ref": "#/$defs/companionPrefix" }
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "clrGeneration", "prefix", "recipe"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "version": { "$ref": "#/$defs/version" },
        "clrGeneration": { "enum": ["clr2", "clr4"] },
        "prefix": { "$ref": "#/$defs/prefix" },
        "recipe": {
          "anyOf": [
            { "$ref": "#/$defs/winetricksRecipe" },
            { "$ref": "#/$defs/operatorInstallerRecipe" }
          ]
        }
      }
    },
    "winetricksRecipe": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "verb"],
      "properties": {
        "kind": { "const": "winetricks" },
        "verb": { "$ref": "#/$defs/winetricksVerb" },
        "sharedClr2FeaturePack": { "type": "boolean" }
      }
    },
    "operatorInstallerRecipe": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "fileName",
        "sha256",
        "prerequisiteVerb",
        "arguments"
      ],
      "properties": {
        "kind": { "const": "operator-installer" },
        "fileName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*\\.exe$"
        },
        "sha256": { "$ref": "#/$defs/sha256" },
        "prerequisiteVerb": { "$ref": "#/$defs/winetricksVerb" },
        "arguments": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": {
            "type": "string",
            "minLength": 2,
            "maxLength": 64,
            "pattern": "^/[A-Za-z0-9:._=-]+$"
          }
        }
      }
    }
  }
}
