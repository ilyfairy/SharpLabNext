{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ArtifactStore": {
    "RootPath": "data/artifact-store",
    "MaxContentBytes": 67108864,
    "MaxArtifactBytes": 268435456,
    "MaxArtifactFiles": 2048,
    "DefaultTimeToLive": "1.00:00:00",
    "MaximumTimeToLive": "30.00:00:00",
    "MaximumLeaseDuration": "00:30:00",
    "CleanupInterval": "00:05:00",
    "CleanupBatchSize": 1000
  },
  "AllowedHosts": "*"
}
