<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <DefineConstants Condition="'$(ConstGenericsSourceBuild)' == 'true'">$(DefineConstants);CONST_GENERICS_SOURCE_BUILD</DefineConstants>
    <NuGetLockFilePath Condition="'$(ConstGenericsSourceBuild)' == 'true'">packages.source.lock.json</NuGetLockFilePath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SharpLabNext.Worker.Roslyn.ConstGenerics\SharpLabNext.Worker.Roslyn.ConstGenerics.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\SharpLabNext.Worker.Roslyn.ConstGenerics\appsettings.json"
          Link="const-generics-appsettings.json"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup Condition="'$(ConstGenericsSourceBuild)' == 'true'">
    <Reference Include="$(ConstGenericsAssemblyDirectory)/Microsoft.CodeAnalysis*.dll">
      <Private>true</Private>
    </Reference>
    <Reference Include="$(ConstGenericsMetadataAssemblyPath)">
      <Private>true</Private>
    </Reference>
  </ItemGroup>

</Project>
