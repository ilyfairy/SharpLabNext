{
  "ArtifactStore": {
    "BaseUrl": "http://artifact-store:8080"
  },
  "ArtifactWorker": {
    "ReleaseId": "content",
    "WorkerImageId": "content",
    "VerificationProfiles": ["default"],
    "Limits": {
      "MaxConcurrentJobs": 2,
      "MaxArtifactFiles": 128,
      "MaxArtifactBytes": 33554432,
      "MaxAssemblyBytes": 16777216,
      "MaxPortablePdbBytes": 8388608,
      "MaxOutputCharacters": 1000000,
      "MaxOutputBytes": 4194304,
      "MaxFindings": 1000,
      "MaxLinkedRanges": 20000,
      "MaxProcessorMilliseconds": 15000,
      "MaxProcessorMemoryBytes": 536870912,
      "MaxProcessorResponseBytes": 2097152,
      "MaxRetainedOperations": 512
    },
    "ReferenceSets": {
      "net10-ref": {
        "Paths": ["/reference-sets/net10-ref"],
        "SystemModuleName": "System.Runtime"
      },
      "net11-preview-ref": {
        "Paths": ["/reference-sets/net11-preview-ref"],
        "SystemModuleName": "System.Runtime"
      },
      "netfx20-managed-ref": {
        "Paths": ["/reference-sets/netfx20-managed-ref"],
        "SystemModuleName": "mscorlib"
      },
      "netfx30-managed-ref": {
        "Paths": ["/reference-sets/netfx30-managed-ref"],
        "SystemModuleName": "mscorlib"
      },
      "netfx35-managed-ref": {
        "Paths": ["/reference-sets/netfx35-managed-ref"],
        "SystemModuleName": "mscorlib"
      },
      "netfx40-managed-ref": {
        "Paths": ["/reference-sets/netfx40-managed-ref"],
        "SystemModuleName": "mscorlib"
      },
      "netfx45-managed-ref": {
        "Paths": ["/reference-sets/netfx45-managed-ref"],
        "SystemModuleName": "mscorlib"
      },
      "netfx451-managed-ref": {
        "Paths": ["/reference-sets/netfx451-managed-ref"],
        "SystemModuleName": "mscorlib"
      },
      "netfx452-managed-ref": {
        "Paths": ["/reference-sets/netfx452-managed-ref"],
        "SystemModuleName": "mscorlib"
      },
      "netfx46-managed-ref": {
        "Paths": ["/reference-sets/netfx46-managed-ref"],
        "SystemModuleName": "mscorlib"
      },
      "netfx461-managed-ref": {
        "Paths": ["/reference-sets/netfx461-managed-ref"],
        "SystemModuleName": "mscorlib"
      },
      "netfx462-managed-ref": {
        "Paths": ["/reference-sets/netfx462-managed-ref"],
        "SystemModuleName": "mscorlib"
      },
      "netfx47-managed-ref": {
        "Paths": ["/reference-sets/netfx47-managed-ref"],
        "SystemModuleName": "mscorlib"
      },
      "netfx471-managed-ref": {
        "Paths": ["/reference-sets/netfx471-managed-ref"],
        "SystemModuleName": "mscorlib"
      },
      "netfx472-managed-ref": {
        "Paths": ["/reference-sets/netfx472-managed-ref"],
        "SystemModuleName": "mscorlib"
      },
      "netfx48-managed-ref": {
        "Paths": ["/reference-sets/netfx48-managed-ref"],
        "SystemModuleName": "mscorlib"
      },
      "jsharp20-ref": {
        "Paths": ["/reference-sets/jsharp20-ref"],
        "SystemModuleName": "mscorlib"
      }
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
