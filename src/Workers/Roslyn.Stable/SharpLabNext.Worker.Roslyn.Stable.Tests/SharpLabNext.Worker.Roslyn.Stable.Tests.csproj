<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies.net20" GeneratePathProperty="true" PrivateAssets="all" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies.net48" GeneratePathProperty="true" PrivateAssets="all" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SharpLabNext.Worker.Roslyn.Stable\SharpLabNext.Worker.Roslyn.Stable.csproj" />
    <ProjectReference Include="..\..\..\..\tests\Shared\SharpLabNext.Testing\SharpLabNext.Testing.csproj" />
  </ItemGroup>

  <ItemGroup>
    <NetFx20ReferenceAssembly Include="$(PkgMicrosoft_NETFramework_ReferenceAssemblies_net20)\build\.NETFramework\v2.0\*.dll" />
    <NetFx48ReferenceAssembly Include="$(PkgMicrosoft_NETFramework_ReferenceAssemblies_net48)\build\.NETFramework\v4.8\*.dll" />
    <NetFx48ReferenceAssembly Include="$(PkgMicrosoft_NETFramework_ReferenceAssemblies_net48)\build\.NETFramework\v4.8\Facades\*.dll" />
  </ItemGroup>

  <Target Name="CopyNetFx48ReferenceAssemblies" AfterTargets="Build">
    <MakeDir Directories="$(OutDir)netfx20-managed-ref" />
    <Copy
      SourceFiles="@(NetFx20ReferenceAssembly)"
      DestinationFolder="$(OutDir)netfx20-managed-ref"
      SkipUnchangedFiles="true" />
    <MakeDir Directories="$(OutDir)netfx48-managed-ref" />
    <Copy
      SourceFiles="@(NetFx48ReferenceAssembly)"
      DestinationFolder="$(OutDir)netfx48-managed-ref"
      SkipUnchangedFiles="true" />
  </Target>

</Project>
