<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseAppHost>false</UseAppHost>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyMetadata Include="SharpLabNext.MobiusILAsmVersion" Value="$(MobiusILAsmVersion)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\Contracts\SharpLabNext.Contracts\SharpLabNext.Contracts.csproj" />
    <PackageReference Include="Mobius.ILasm" />
    <!-- Pin over the vulnerable legacy transitive dependency shipped by Mobius 0.1.0. -->
    <PackageReference Include="System.Security.Permissions" />
  </ItemGroup>

</Project>
