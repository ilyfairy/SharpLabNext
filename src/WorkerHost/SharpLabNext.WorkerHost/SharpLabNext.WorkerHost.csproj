    <IsSharpLabNextPublicPackage>true</IsSharpLabNextPublicPackage>
    <PackageId>SharpLabNext.WorkerHost</PackageId>
    <Description>Common ASP.NET Core host registration and health endpoints for SharpLabNext extension workers.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\..\Infrastructure\InternalServiceAuthentication.cs"
             Link="Infrastructure\InternalServiceAuthentication.cs" />
    <Compile Include="..\..\Infrastructure\PascalCaseProblemDetails.cs"
             Link="Infrastructure\PascalCaseProblemDetails.cs" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
